{% stylesheet %}
.product-highlights {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 40px 0;
  flex-wrap: wrap;
  max-width: 100%;
  width: 100%;
  padding-left: 5rem;
  padding-right: 5rem;
}
.product-highlight-block {
  flex: 0 0 23%; /* ≈ 25% minus gap */
  background-color: var(--bg-color);
  border-radius: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 100%;
}
.highlight-text {
  max-width: 50%;
  padding-left: 25px;
  height: 100%;
  padding-top: 10px;
}
.highlight-text h3 {
  font-size: 28px;
  font-weight: 700;
  margin: 0 0 6px;
  line-height: 40px;
}
.highlight-underline {
  width: 80px;
  height: 4px;
  background: #cc2d30;
  margin-bottom: 12px;
  display: block !important;
}
.highlight-subtext {
  font-weight: bold;
  font-size: 14px;
}
.highlight-image {
  max-width: 45%;
}
.highlight-image img {
  max-width: 100%;
  height: auto;
}
{% endstylesheet %}

<div class="product-highlights">
  {% for block in section.blocks %}
    <div class="product-highlight-block" style="--bg-color: {{ block.settings.bg_color }}">
      <div class="highlight-text">
        <h3>{{ block.settings.title | newline_to_br }}</h3>
        <div class="highlight-underline"></div>
        <div class="highlight-subtext">{{ block.settings.subtext }}</div>
      </div>
      <div class="highlight-image">
        <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title | escape }}">
      </div>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Product Highlights",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Strength Cure"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "FOR DAMAGED HAIR"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color",
          "default": "#ddeeff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Highlights",
      "category": "Custom",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "title": "Strength Cure",
            "subtext": "FOR DAMAGED HAIR",
            "bg_color": "#ddeeff"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Strength\nCure Blonde",
            "subtext": "FOR LIGHTENED HAIR",
            "bg_color": "#caffdd"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Nano\nWorks Gold",
            "subtext": "FOR HAIR REVIVAL",
            "bg_color": "#fde4c6"
          }
        }
      ]
    }
  ]
}
{% endschema %}
