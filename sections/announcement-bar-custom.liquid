<div class="custom-announcement-bar">
  <div class="custom-announcement-bar__content">
    <span class="custom-announcement-bar__icon" aria-hidden="true">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect x="3" y="9" width="18" height="12" rx="1" stroke="currentColor" stroke-width="1.5"/>
        <path d="M12 9V21" stroke="currentColor" stroke-width="1.5"/>
        <path d="M3 13H21" stroke="currentColor" stroke-width="1.5"/>
        <path d="M12 9H7.5C6.12 9 5 7.88 5 6.5C5 5.12 6.12 4 7.5 4C10 4 12 9 12 9Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <path d="M12 9H16.5C17.88 9 19 7.88 19 6.5C19 5.12 17.88 4 16.5 4C14 4 12 9 12 9Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
      </svg>
    </span>

    <span class="custom-announcement-bar__text">
      {{ section.settings.announcement_text }}
    </span>
  </div>
</div>

<style>
  .custom-announcement-bar {
    width: 100%;
    background: #000;
    color: #fff;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .custom-announcement-bar__content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 0 15px;
    text-align: center;
    box-sizing: border-box;
  }

  .custom-announcement-bar__icon {
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 24px;
  }

  .custom-announcement-bar__icon svg {
    width: 24px;
    height: 24px;
    display: block;
  }

  .custom-announcement-bar__text {
    font-size: 16px;
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: 0;
  }

  @media screen and (max-width: 749px) {
    .custom-announcement-bar {
      height: 44px;
    }

    .custom-announcement-bar__content {
      gap: 5px;
      padding: 0 10px;
    }

    .custom-announcement-bar__icon {
      width: 20px;
      height: 20px;
      flex-basis: 20px;
    }

    .custom-announcement-bar__icon svg {
      width: 20px;
      height: 20px;
    }

    .custom-announcement-bar__text {
      font-size: 13px;
      line-height: 1.2;
    }
  }

  @media screen and (max-width: 374px) {
    .custom-announcement-bar__text {
      font-size: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "FREE Gifts with Eligible Purchases"
    }
  ],
  "presets": [
    {
      "name": "Custom Announcement Bar"
    }
  ]
}
{% endschema %}