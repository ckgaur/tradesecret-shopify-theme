{% comment %}
  Trustpilot Slider Section
  Trade Secrets - Full Width
{% endcomment %}

<section
  class="trustpilot-slider-section"
  style="
    --trustpilot-padding-top: {{ section.settings.padding_top }}px;
    --trustpilot-padding-bottom: {{ section.settings.padding_bottom }}px;
    --trustpilot-bg-color: {{ section.settings.background_color }};
  "
>
  <div class="trustpilot-slider__container">

    {% if section.settings.heading != blank %}
      <div class="trustpilot-slider__heading">
        <h2 class="rich-text__heading rte inline-richtext h4">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="trustpilot-slider__widget">

      <!-- Trustpilot Script -->
      <script data-lazy-src="https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js"></script>

      <!-- Trustpilot Widget -->
      <div
        class="trustpilot-widget"
        data-locale="en-US"
        data-template-id="54ad5defc6454f065c28af8b"
        data-businessunit-id="5fb5a841ee9c7c0001b25a5c"
        data-style-height="240px"
        data-style-width="100%"
        data-token="1c9bfc1a-fdd0-4add-8e33-1cc8be41db9a"
        data-stars="4,5"
        data-review-languages="en"
      >
        <a
          href="https://www.trustpilot.com/review/tradesecrets.ca"
          target="_blank"
          rel="noopener noreferrer"
        >
          Trustpilot
        </a>
      </div>

    </div>

  </div>
</section>

<style>
  .trustpilot-slider-section {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding-top: var(--trustpilot-padding-top);
    padding-bottom: var(--trustpilot-padding-bottom);
    background-color: var(--trustpilot-bg-color);
    overflow: hidden;
  }

  .trustpilot-slider__container {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  .trustpilot-slider__heading {
    width: 100%;
    text-align: center;
    margin: 0 0 24px;
    padding: 0 20px;
  }

  .trustpilot-slider__heading h2 {
    margin: 0;
  }

  .trustpilot-slider__widget {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  .trustpilot-widget {
    width: 100% !important;
    max-width: 100% !important;
  }

  @media screen and (max-width: 749px) {
    .trustpilot-slider__heading {
      margin-bottom: 16px;
      padding: 0 15px;
    }
  }
</style>

{% schema %}
{
  "name": "Trustpilot Slider",
  "tag": "section",
  "class": "section-trustpilot-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Trustpilot Slider"
    }
  ]
}
{% endschema %}
