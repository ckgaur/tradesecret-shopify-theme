{% comment %}
  Best Sellers Slider Section
{% endcomment %}
<section class="best-sellers-section">
  <div class="page-width">
    <h2 class="section-heading center">Best Sellers</h2>
    <div class="best-sellers-slider-wrapper">
      <div class="best-sellers-slider swiper">
        <div class="swiper-wrapper">
          {% for product in collections[section.settings.collection].products %}
            <div class="swiper-slide product-card">
              <div class="product-card__image-wrapper">
                {% if product.compare_at_price > product.price %}
                  <div class="discount-badge">25% Off</div>
                {% endif %}
                <a href="{{ product.url }}">
                  <img
                    src="{{ product.featured_image | img_url: '600x' }}"
                    alt="{{ product.title }}"
                    class="product-card__image"
                  >
                </a>
                <div class="wishlist-icon">♡</div>
              </div>
              <div class="product-card__info center">
                <p class="product-title">{{ product.title }}</p>
                <div class="product-rating">
                  {% for i in (1..5) %}
                    <span class="star">★</span>
                  {% endfor %}
                  <span class="review-count">(47)</span>
                </div>
                <div class="product-price">
                  <span class="price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="compare-price">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="slider-nav prev">‹</div>
        <div class="slider-nav next">›</div>
      </div>
    </div>
  </div>
</section>

<style>
.best-sellers-section {
  padding: 3rem 0;
}
.section-heading {
  font-size: 2rem;
  font-weight: 600;
  margin-bottom: 2rem;
}
.best-sellers-slider-wrapper {
  position: relative;
}
.swiper-wrapper {
  display: flex;
  overflow-x: auto;
  scroll-behavior: smooth;
}
.product-card {
  min-width: 240px;
  max-width: 300px;
  margin: 0 10px;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.05);
}
.product-card__image-wrapper {
  position: relative;
  padding: 20px;
}
.discount-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: #d0011b;
  color: #fff;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: bold;
}
.wishlist-icon {
  position: absolute;
  top: 10px;
  right: 10px;
  font-size: 1.3rem;
  background: #fff;
  border-radius: 50%;
  padding: 6px;
}
.product-card__image {
  width: 100%;
  height: auto;
  display: block;
}
.product-card__info {
  padding: 10px 15px 20px;
}
.product-title {
  font-size: 0.95rem;
  margin-bottom: 6px;
}
.product-rating {
  color: #f5a623;
  font-size: 0.9rem;
  margin-bottom: 8px;
}
.product-price {
  font-weight: 600;
  font-size: 1rem;
}
.compare-price {
  text-decoration: line-through;
  color: #999;
  font-weight: 400;
  margin-left: 8px;
}
.slider-nav {
  position: absolute;
  top: 40%;
  transform: translateY(-50%);
  background: #ffeaea;
  color: #000;
  font-size: 1.5rem;
  padding: 6px 10px;
  border-radius: 50%;
  cursor: pointer;
  z-index: 2;
}
.slider-nav.prev {
  left: -20px;
}
.slider-nav.next {
  right: -20px;
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const wrapper = document.querySelector('.swiper-wrapper');
    const prev = document.querySelector('.slider-nav.prev');
    const next = document.querySelector('.slider-nav.next');

    prev.addEventListener('click', () => {
      wrapper.scrollBy({ left: -300, behavior: 'smooth' });
    });
    next.addEventListener('click', () => {
      wrapper.scrollBy({ left: 300, behavior: 'smooth' });
    });
  });
</script>

{% schema %}
{
  "name": "Best Sellers Slider",
  "tag": "section",
  "class": "shopify-section--best-sellers",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Product Collection"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers",
      "category": "Products",
      "settings": {
        "collection": ""
      }
    }
  ]
}
{% endschema %}
