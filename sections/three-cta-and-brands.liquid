{% stylesheet %}
.cta-brand-section {
  padding: 60px 0px;
  width: 100%;
  max-width: 100%;
  text-align: center;
}

.cta-cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 60px;
  text-align: left;
}

.cta-card {
  flex: 1;
  min-width: 300px;
  background-color:rgb(255, 255, 255);
  color:rgb(0, 0, 0);
  position: relative;
  overflow: hidden;
  border-radius: 10px;
  border: 2px solidrgb(255, 255, 255);
  display: block; /* anchor as block */
  text-decoration: none; /* remove link underline */
  color: inherit;
  transition: opacity 0.3s ease;
}

.cta-card:hover {
  opacity: 0.95;
  cursor: pointer;
}

.cta-card img {
  width: 100%;
  height: auto;
  object-fit: cover;
  display: block;
}

.cta-card-content {
  position: absolute;
  top: 0;
  left: 0;
  padding: 20px 30px;
  width: 70%;
}

.cta-card h3 {
  font-size: 26px;
  margin-bottom: 10px;
  color: white;
}

.cta-card p {
  font-size: 16px;
  color: white;
}

.cta-button {
  display: block;
  margin-top: auto;
  background-color:rgb(255, 255, 255);
  color:rgb(0, 0, 0);
  padding: 15px 25px;
  text-align: left;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
  text-decoration: none;
  font-weight: 500;
  position: relative;
}

.cta-button::after {
  content: '›';
  font-size: 26px;
  margin-left: 8px;
  position: relative;
  top: -1px;
}

.brand-heading {
  font-size: 28px;
  margin-bottom: 30px;
  margin-top: 20px;
}

.brand-logos {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 30px;
  width: 100%;
  box-sizing: border-box;
}

.brand-logo {
  background: #fff;
  padding: 40px 50px;
  border-radius: 10px;
  flex: 1 1 calc(25% - 30px);
  max-width: calc(25% - 30px);
  box-sizing: border-box;
  text-align: center;
}

.brand-logo img {
  max-width: 100%;
  height: auto;
}

@media (max-width: 1024px) {
  .brand-logo {
    flex: 1 1 calc(50% - 30px);
    max-width: calc(50% - 30px);
  }
}

@media (max-width: 600px) {
  .brand-logo {
    flex: 1 1 100%;
    max-width: 100%;
  }
}
{% endstylesheet %}

<section class="cta-brand-section">
  <div class="cta-cards">
    {% for block in section.blocks %}
      {% if block.type == 'cta' %}
        <a href="{{ block.settings.button_link }}" class="cta-card">
          {%- assign cta_img_h = 800 -%}
          {%- if block.settings.image.aspect_ratio -%}{%- assign cta_img_h = 800 | divided_by: block.settings.image.aspect_ratio -%}{%- endif -%}
          <img src="{{ block.settings.image | img_url: '800x' }}" width="800" height="{{ cta_img_h }}" alt="" loading="lazy">
          <div class="cta-card-content">
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.subtext }}</p>
          </div>
          <span class="cta-button">
            {{ block.settings.button_label }}
          </span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
  <div class="brand-section">
    <h2 class="brand-heading"></h2>
    <div class="brand-logos">
      {% for block in section.blocks %}
        {% if block.type == 'brand' %}
          <div class="brand-logo">
            {%- assign brand_logo_h = 400 -%}
            {%- if block.settings.brand_logo.aspect_ratio -%}{%- assign brand_logo_h = 400 | divided_by: block.settings.brand_logo.aspect_ratio -%}{%- endif -%}
            <img src="{{ block.settings.brand_logo | img_url: '400x' }}" width="400" height="{{ brand_logo_h }}" alt="" loading="lazy">
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

