{% stylesheet %}
.summer-sale-slider {
  text-align: center;
  padding: 40px 0;
  position: relative;
}

.summer-sale-slider h2 {
  font-size: 32px;
  font-weight: 600;
}

.summer-sale-slider p {
  font-size: 16px;
  margin-top: 10px;
  color: #555;
}

.sale-cards-wrapper {
  position: relative;
  max-width: 100%;
  margin: 40px auto;
  padding-left: 5rem;
  padding-right: 5rem;
  overflow: hidden;
}

.sale-cards {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  height: auto;
  padding-bottom: 10px;
}

.sale-card {
  scroll-snap-align: start;
  flex: 0 0 calc(100% - 0px);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 10px;
  color: #000;
  background-color: #f2f2f2;
  text-decoration: none; /* remove link underline */
}

.card-content {
  max-width: 50%;
  padding-left: 40px;
  text-align: left;
  height: 100%;
  padding-top: 25px;
}

.sale-card .discount {
  font-size: 22px;
  font-weight: 700;
  color: #cc2d30;
}

.sale-card .title {
  font-size: 25px;
  font-weight: 600;
  margin: 5px 0;
}

.sale-card .btn {
  margin-top: 10px;
  font-weight: 600;
  color: #000;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  pointer-events: none; /* button is decorative since whole card is clickable */
}

.sale-card .btn svg {
  margin-left: 6px;
  width: 14px;
  height: 14px;
}

.sale-image img {
  max-width: 100%;
  height: 100%;
  object-fit: cover;
}

.sale-image {
  height: 100%;
}

.arrow-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: #fff0f0;
  border-radius: 50%;
  border: 1px solid #ddd;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 2;
}

.arrow-left {
  left: 0px;
}

.arrow-right {
  right: 0px;
}

.sale-card:nth-child(1) { background-color: #FFE7C6 !important; }
.sale-card:nth-child(2) { background-color: #D3E5FF !important; }
.sale-card:nth-child(3) { background-color: #D0FFE4 !important; }

@media (min-width: 767px) {
  .sale-card {
    flex: 0 0 calc(50% - 0px);
  }
}

@media (min-width: 1024px) {
  .sale-card {
    flex: 0 0 calc(33.33% - 0px);
  }
}

@media (max-width: 767px) {
  .sale-cards-wrapper {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .sale-image img {
    max-width: 100%;
    height: 100%;
  }
  .sale-image {
    height: 100%;
  }
}
{% endstylesheet %}

<div class="summer-sale-slider">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.subheading }}</p>

  <div class="sale-cards-wrapper">
    <!-- Optional Arrows (scrolls the flex container) -->
    <button class="arrow-btn arrow-left" onclick="document.querySelector('.sale-cards').scrollLeft -= 320">&#10094;</button>

    <div class="sale-cards">
      {% for block in section.blocks %}
        {% assign card_link = block.settings.button_link %}
        {% if card_link != blank %}
          <a href="{{ card_link }}" class="sale-card" style="background-color: {{ block.settings.bg_color }}">
        {% else %}
          <div class="sale-card" style="background-color: {{ block.settings.bg_color }}">
        {% endif %}
            <div class="card-content">
              <div class="discount">{{ block.settings.discount_text }}</div>
              <div class="title">{{ block.settings.product_title }}</div>
              {% if block.settings.button_label != blank %}
                <span class="btn">
                  {{ block.settings.button_label }}
                  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              {% endif %}
            </div>
            <div class="sale-image">
              {% if block.settings.image %}
                <img 
                  src="{{ block.settings.image | image_url: width: 520 }}" 
                  srcset="
                    {{ block.settings.image | image_url: width: 260 }} 1x,
                    {{ block.settings.image | image_url: width: 520 }} 2x
                  "
                  width="260"
                  height="300"
                  alt="{{ block.settings.product_title }}"
                  loading="lazy"
                />
              {% endif %}
            </div>
        {% if card_link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <button class="arrow-btn arrow-right" onclick="document.querySelector('.sale-cards').scrollLeft += 320">&#10095;</button>
  </div>
</div>

{% schema %}
{
  "name": "Summer Sale Slider",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Our Summer Sale Is On!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hot Deals, Cool Prices. Shop Your Favourites Now!"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "discount_text",
          "label": "Discount Text",
          "default": "20% Off"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title",
          "default": "Redken Litres"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#fff5e5"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Summer Sale Promo",
      "category": "Promotions",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "discount_text": "20% Off",
            "product_title": "Redken Litres",
            "bg_color": "#fff5e5"
          }
        },
        {
          "type": "slide",
          "settings": {
            "discount_text": "50% Off",
            "product_title": "LA Roche Posay",
            "bg_color": "#e3edff"
          }
        },
        {
          "type": "slide",
          "settings": {
            "discount_text": "25% Off",
            "product_title": "OPI Nail Paints",
            "bg_color": "#e3fcef"
          }
        }
      ]
    }
  ]
}
{% endschema %}
