<!-- sections/app-store-buttons.liquid -->

<style>
  .app-buttons-section {
    display: flex;
    justify-content: center;
    gap: 40px;
    padding: 40px 0;
    background-color: #fff;
  }

  .app-buttons-section a {
    display: inline-block;
    
  }

  .app-buttons-section a:hover img {
    transform: scale3d(1.1, 1.1, 1.1);
  }

  .app-buttons-section img {
    max-width: 100%;
    height: auto;
    display: block;
    transition: transform .5s;
  }
</style>

<div class="app-buttons-section">
  {% if section.settings.app_store_image %}
    <a href="{{ section.settings.app_store_link }}" target="_blank">
      <img src="{{ section.settings.app_store_image | image_url: width: 400 }}" alt="Download on the App Store">
    </a>
  {% endif %}
  {% if section.settings.google_play_image %}
    <a href="{{ section.settings.google_play_link }}" target="_blank">
      <img src="{{ section.settings.google_play_image | image_url: width: 400 }}" alt="Get it on Google Play">
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "App Store Buttons",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "app_store_image",
      "label": "App Store Image"
    },
    {
      "type": "url",
      "id": "app_store_link",
      "label": "App Store Link",
    },
    {
      "type": "image_picker",
      "id": "google_play_image",
      "label": "Google Play Image"
    },
    {
      "type": "url",
      "id": "google_play_link",
      "label": "Google Play Link",
    }
  ],
  "presets": [
    {
      "name": "App Store Buttons",
      "category": "Custom"
    }
  ]
}
{% endschema %}
