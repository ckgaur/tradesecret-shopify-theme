{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
		--logo-width: {{ settings.logo_width }}px;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
		padding-top: {{ section.settings.padding_top_mb }}px;
  }
	
	.footer__content-bottom {
		padding-bottom: {{ section.settings.padding_bottom_mb }}px;
	}

  .footer__bottom-image {
      margin-top: {{ section.settings.image_margin_top_mb }}px;
      margin-bottom: {{ section.settings.image_margin_bottom_mb }}px;
    }

  @media screen and (min-width: 750px) {
		.footer__content-bottom {
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
		.footer {
			margin-top: {{ section.settings.margin_top }}px;
			padding-top: {{ section.settings.padding_top }}px;
    }

    .footer__bottom-image {
      margin-top: {{ section.settings.image_margin_top }}px;
      margin-bottom: {{ section.settings.image_margin_bottom }}px;
    }
    
  }

	@media only screen and (min-width: 1560px) {
		.extra-large-layout .footer {
			margin-top: calc({{ section.settings.margin_top }}px * 1.333333);
			padding-top: calc({{ section.settings.padding_top }}px * 1.333333);
    }
  }
{%- endstyle -%}

{%- liquid
  assign banner_img_alt = section.settings.image.alt | default: section.settings.image_mobile.alt | default: page.title | default: shop.name
  assign banner_img_alt_mobile = section.settings.image_mobile.alt | default: section.settings.image.alt | default: page.title | default: shop.name
-%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient">

  {%- if section.settings.image != blank and section.settings.image_position_mb == 'top' -%}
    <div class="footer__bottom-image footer__bottom-image--top {% if section.settings.image_full_width == false %} page-width {% endif %} medium-hide large-up-hide">
      {%- if section.settings.image_mobile != blank and section.settings.image_position_mb == 'top' -%}
        <div
          class="
            media media--{{  section.settings.image_height }}
            {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}
          "
          {% if section.settings.image_height == 'adapt-image' %}
            style="--image-height: {{ 1 | divided_by: section.settings.image_mobile.aspect_ratio | times: 100 }}%;"
          {% endif %}
        >
          {%- liquid
            assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              assign image_height = section.settings.image_mobile.width | divided_by: section.settings.image_mobile.aspect_ratio
              assign sizes = '100vw'
          -%}
          {{
            section.settings.image_mobile
            | image_url: width: 3840
            | image_tag: width: section.settings.image_mobile.width, height: image_height, sizes: sizes, widths: widths, alt: banner_img_alt_mobile
          }}
        </div>
      {%- else -%}
        <div
          class="
            media media--{{  section.settings.image_height }}
            {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}
          "
          {% if section.settings.image_height == 'adapt-image' %}
            style="--image-height: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
          {% endif %}
        >
          {%- liquid
            assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
            assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
            assign sizes = '100vw'
          -%}
          {{
            section.settings.image
            | image_url: width: 3840
            | image_tag: width: section.settings.image.width, height: image_height, sizes: sizes, widths: widths, alt: banner_img_alt
          }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_linkedin_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif

    if settings.brand_image == blank and settings.brand_headline == blank and settings.brand_description == blank
      assign brand_empty = true
    endif

    if section.blocks.size == 1 and section.blocks[0].type == 'brand_information' and brand_empty and has_social_icons == false and section.settings.newsletter_enable == false and section.settings.enable_follow_on_shop == false
      assign only_empty_brand = true
    endif
  -%}
  {%- if section.blocks.size > 0
    or section.settings.newsletter_enable
    or section.settings.show_social
    and has_social_icons == true
    or section.settings.enable_follow_on_shop
  -%}
    {%- unless only_empty_brand -%}
      <div class="footer__content-top page-width">
        {%- if section.blocks.size > 0 -%}
          {%- liquid
            if section.blocks.size == 9
              assign footer_grid_class = 'grid--3-col-tablet'
            elsif section.blocks.size > 6
              assign footer_grid_class = 'grid--4-col-desktop'
            elsif section.blocks.size > 4
              assign footer_grid_class = 'grid--3-col-tablet'
            endif
          -%}

          <div class="footer__blocks-wrapper grid {% if section.settings.menu_layout != 'accordion' %} grid--2-col {% else %} grid--1-col {% endif %} grid--4-col-tablet {{ footer_grid_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %} data-cascade {% endif %}>

            {%- for block in section.blocks -%}
              <{% if block.type == 'link_list' and section.settings.menu_layout == 'accordion' %}accordion-panel{% else %}div{% endif %}
                class="footer-block grid__item{% if block.type == 'link_list' %} footer-block--menu footer-block--menu-{{ section.settings.menu_layout }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %} data-cascade style="--animation-order: {{ forloop.index }};"{% endif %} {{ block.shopify_attributes }}>

                {%- if block.settings.heading != blank -%}
                  <h2 class="footer-block__heading clr-text-{{ section.settings.top_text_color }} inline-richtext {{ block.settings.heading_size }} {{ section.settings.heading_weight }}" {%  if section.settings.menu_layout == 'accordion' %}data-component="toggle"{% endif %}>
                    {{- block.settings.heading -}}
										{%- if section.settings.menu_layout == 'accordion' and block.type == 'link_list' -%}
											{% render 'icon-caret', class: 'medium-hide large-up-hide' %}
										{%- endif -%}
                  </h2>
                {%- endif -%}

                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}

                  {%- when 'text' -%}
                    <div class="footer-block__details-content rte">
                      {{ block.settings.subtext }}
                    </div>

                  {%- when 'link_list' -%}
                    {%- if block.settings.menu != blank -%}
                      <div class="footer-block__details-content footer__menu list-unstyled footer__menu--{{ section.settings.menu_layout }}" {% if section.settings.menu_layout == 'accordion' %} data-component="dropdown" {% endif %}>
                        {%- for link in block.settings.menu.links -%}
                          <div class="footer__menu-link">
                            <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link {{ block.settings.menu_text_size }} {% if link.active %} list-menu__item--active{% endif %}">
															<span class="link-underline">
																{{ link.title }}
															</span>
                            </a>
                          </div>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}

                  {%- when 'brand_information' -%}
                    <div class="footer-block__brand-info">

                      {%- if settings.brand_image != blank -%}
                        {%- liquid
                          assign brand_image_height = settings.brand_image_width | divided_by: settings.brand_image.aspect_ratio
                          assign brand_img_alt = settings.brand_image.alt | default: settings.brand_headline | strip_html | default: shop.name
                        -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ settings.brand_image_width }}px);"
                        >
                          {{
                            settings.brand_image
                            | image_url: width: 1100
                            | image_tag:
                              loading: 'lazy',
                              widths: '50, 100, 150, 200, 300, 400, 550, 800, 1100',
															alt: brand_img_alt,
                              height: brand_image_height,
                              width: settings.brand_image_width
                          }}
                        </div>
                      {%- endif -%}

                      {%- if settings.brand_headline != blank -%}
                        <h2 class="footer-block__heading clr-text-{{ section.settings.top_text_color }} rte {{ block.settings.heading_size }} {{ section.settings.heading_weight }}">
                          {{ settings.brand_headline }}
                        </h2>
                      {%- endif -%}

                      {%- if settings.brand_description != blank -%}
                        <div class="footer-block__brand-description rte">{{ settings.brand_description }}</div>
												
                      {%- endif -%}

                      {%- if block.settings.show_social and has_social_icons -%}
                        {%- render 'social-icons',
                          class: 'footer__list-social',
													style: 'rounded'
                        -%}
                      {%- endif -%}
                    </div>

                  {%- when 'image' -%}
                    <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                      {%- if block.settings.image != blank -%}
                        {%- liquid
                          assign image_size_2x = block.settings.image_width | times: 2 | at_most: 5760
                          assign block_img_alt = block.settings.image.alt | default: block.settings.heading | strip_html | default: page.title | default: shop.name
                        -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ block.settings.image_width }}px);"
                        >
                          <img
                            srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                            src="{{ block.settings.image | image_url: width: 760 }}"
                            alt="{{ block_img_alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        </div>
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                      {%- endif -%}
                    </div>

                {%- endcase -%}
              </{% if block.type == 'link_list' and section.settings.menu_layout == 'accordion' %}accordion-panel{% else %}div{% endif %}>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="footer-block--newsletter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %} data-cascade {% endif %}>

          {%- if section.settings.newsletter_enable -%}
            <div class="footer-block__newsletter">
              {%- if section.settings.newsletter_heading != blank -%}
                <h2 class="footer-block__heading clr-text-{{ section.settings.top_text_color }} inline-richtext h6 {{ section.settings.heading_weight }}">
                  {{ section.settings.newsletter_heading }}
                </h2>
                <p class="footer-block__newsletter-text">{{ 'sections.footer.newsletter' | t }}</p>
              {%- endif -%}
              {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-form__field-wrapper">
                  <div class="field">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="field__input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                      {% endif %}
                      placeholder="{{ 'newsletter.label' | t }}"
                      required
                    >
                    <label class="field__label" for="NewsletterForm--{{ section.id }}">
											{{- 'sections.footer.newsletter_label' | t -}}
                    </label>
                    <button
                      type="submit"
                      class="newsletter-form__button field__button"
                      name="commit"
                      id="Subscribe"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      {% render 'icon-short-arrow' %}
                    </button>
                  </div>
									<small class="newsletter-form__message form__message" id="ContactFooter-error">
										{%- if form.errors -%}
												{%- render 'icon-error' -%}
												{{- form.errors.translated_fields.email | capitalize }}
												{{ form.errors.messages.email -}}
										{%- endif -%}
									</small>
                </div>
                {%- if form.posted_successfully? -%}
                  <h3
                    class="newsletter-form__message newsletter-form__message--success form__message--success form__message"
                    id="ContactFooter-success"
                    tabindex="-1"
                    autofocus
                  >
                    {% render 'icon-success' -%}
										{{ 'sections.footer.newsletter_success' | t }}
                  </h3>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}

          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="footer__follow-on-shop">
              {{ shop | login_button: action: 'follow' }}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}
  {%- endif -%}

  <div class="footer__content-bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} {% if section.settings.image != blank %} footer__content-bottom--with-image{% endif %}" {% if settings.animations_reveal_on_scroll %} data-cascade {% endif %}>

		{% liquid
			assign footer_content_columns = 0
			assign is_language_localization = false
			assign is_country_localization = false

			if section.settings.enable_language_selector
				if localization.available_languages.size > 1
					assign is_language_localization = true
				endif
			endif

			if section.settings.enable_country_selector
				if localization.available_countries.size > 1
					assign is_country_localization = true
				endif
			endif

			if section.settings.show_social and has_social_icons
				assign footer_content_columns = footer_content_columns | plus: 1
			endif
			if is_language_localization and is_country_localization
				assign footer_content_columns = footer_content_columns | plus: 1
			endif
			if section.settings.payment_enable
				assign footer_content_columns = footer_content_columns | plus: 1
			endif
		%}

    <div class="footer__content-bottom-wrapper page-width footer__content-bottom-wrapper--{{ footer_content_columns }}">
			{%- if section.settings.show_social and has_social_icons -%}
				<div class="footer__column footer__column--social">
					<div class="social-wrap">
						<span class="small-hide clr-text-{{ section.settings.button_text_color }}"> {{ 'sections.footer.socials' | t }}</span>
						{%- render 'social-icons', class: 'footer__list-social', style: 'rounded' -%}
					</div>
				</div>
			{%- endif -%}

      <div class="footer__column footer__localization isolate clr-text-{{ section.settings.button_text_color }}">
        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <noscript>
            {%- form 'localization', id: 'FooterLanguageFormNoScript', class: 'localization-form' -%}
              <div class="localization-form__select">
                <h2 class="visually-hidden" id="FooterLanguageLabelNoScript">
                  {{ 'localization.language_label' | t }}
                </h2>
                <select
                  class="localization-selector link"
                  name="locale_code"
                  aria-labelledby="FooterLanguageLabelNoScript"
                >
                  {%- for language in localization.available_languages -%}
                    <option
                      value="{{ language.iso_code }}"
                      lang="{{ language.iso_code }}"
                      {%- if language.iso_code == localization.language.iso_code %}
                        selected
                      {% endif %}
                    >
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {%- endfor -%}
                </select>
                {% render 'icon-caret' %}
              </div>
              <button class="button button--tertiary">{{ 'localization.update_language' | t }}</button>
            {%- endform -%}
          </noscript>

          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div class="no-js-hidden">
                <h2 class="caption-large text-body hidden" id="FooterLanguageLabel">
                  {{ 'localization.language_label' | t }}
                </h2>
                {%- render 'language-localization', localPosition: 'FooterLanguage', text_weight: section.settings.localization_text_weight -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <noscript>
            {%- form 'localization', id: 'FooterCountryFormNoScript', class: 'localization-form' -%}
              <div class="localization-form__select">
                <h2 class="visually-hidden" id="FooterCountryLabelNoScript">{{ 'localization.country_label' | t }}</h2>
                <select
                  class="localization-selector link"
                  name="country_code"
                  aria-labelledby="FooterCountryLabelNoScript"
                >
                  {%- for country in localization.available_countries -%}
                    <option
                      value="{{ country.iso_code }}"
                      {%- if country.iso_code == localization.country.iso_code %}
                        selected
                      {% endif %}
                    >
                      {{ country.name }} ({{ country.currency.iso_code }}
                      {{ country.currency.symbol }})
                    </option>
                  {%- endfor -%}
                </select>
                {% render 'icon-caret' %}
              </div>
              <button class="button button--tertiary">{{ 'localization.update_country' | t }}</button>
            {%- endform -%}
          </noscript>
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div class="no-js-hidden">
                <h2 class="caption-large text-body hidden" id="FooterCountryLabel">
                  {{ 'localization.country_label' | t }}
                </h2>
                {%- render 'country-localization', localPosition: 'FooterCountry', text_weight: section.settings.localization_text_weight -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>

      <div class="footer__column footer__column--info">
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.image != blank -%}
      <div class="footer__bottom-image {% if section.settings.image_full_width == false %} page-width {% endif %} {% if section.settings.image_position_mb == 'top' %} small-hide {% endif %}">
        <div
          class="
            media media--{{  section.settings.image_height }}
            {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}
          "
          {% if section.settings.image_height == 'adapt-image' %}
            style="--image-height: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
          {% endif %}
        >
          {%- liquid
            assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
            assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
            assign sizes = '100vw'
          -%}
          {{
            section.settings.image
            | image_url: width: 3840
            | image_tag: width: section.settings.image.width, height: image_height, sizes: sizes, widths: widths, alt: banner_img_alt
          }}
        </div>
      </div>
    {%- endif -%}
  </div>
	<div class="footer-policy-section color-{{ section.settings.copyright_color_scheme }} gradient {% if section.settings.enable_country_selector == false and section.settings.enable_language_selector == false %} footer__content-bottom-wrapper--center{% endif %}">
		<div class="page-width footer__policy">
				{%- if section.settings.show_policy -%}
					<ul class="footer__policy-menu list-unstyled">
						{%- for policy in shop.policies -%}
							{%- if policy != blank -%}
								<li>
									<a href="{{ policy.url }}" class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">{{ policy.title }}</a>
								</li>
							{%- endif -%}
						{%- endfor -%}
					</ul>
				{%- endif -%}
			<div class="footer__copyright caption">
				<small class="copyright__content">{{ powered_by_link }}</small>
			</div>
		</div>
	</div>
</footer>

{%- if section.settings.menu_layout == 'accordion' -%}
	<script src="{{ 'footer.js' | asset_url }}" type="module" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Quick links",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h6",
              "label": "Small"
            },
            {
              "value": "h5",
              "label": "Medium"
            },
            {
              "value": "h4",
              "label": "Large"
            }
          ],
          "default": "h6",
          "label": "t:sections.all.heading_size.label",
          "visible_if": "{{ block.settings.heading != blank }}"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        },
        {
          "type": "select",
          "id": "menu_text_size",
          "options": [
            {
              "value": "text-body-size-sm",
              "label": "Small"
            },
            {
              "value": "text-body-size-md",
              "label": "Medium"
            },
            {
              "value": "text-body-size-lg",
              "label": "Large"
            }
          ],
          "default": "text-body-size-md",
          "label": "Links size",
          "visible_if": "{{ block.settings.menu != blank }}"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h6",
              "label": "Small"
            },
            {
              "value": "h5",
              "label": "Medium"
            },
            {
              "value": "h4",
              "label": "Large"
            }
          ],
          "default": "h6",
          "label": "t:sections.all.heading_size.label",
          "visible_if": "{{ settings.brand_headline != blank }}"
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.brand_information.settings.header__1.content"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "text",
