{% schema %}
{
  "name": "Shop By Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Collection or Custom URL)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Category (Simple Carousel)",
      "blocks": []
    }
  ]
}
{% endschema %}

<div class="category-carousel-wrapper">
  {% if section.settings.heading != blank %}
    <h2 class="category-carousel-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="carousel-container">
    <button class="carousel-arrow left" onclick="scrollCarousel(this, -1)">&#8249;</button>
    <div class="carousel-track">
      {% for block in section.blocks %}
        <div class="carousel-item">
          {% if block.settings.link %}
            <a href="{{ block.settings.link }}">
          {% endif %}
              {% if block.settings.image %}
                {%- assign category_img_h = 300 -%}
                {%- if block.settings.image.aspect_ratio -%}{%- assign category_img_h = 300 | divided_by: block.settings.image.aspect_ratio -%}{%- endif -%}
                <img src="{{ block.settings.image | image_url: width: 300 }}" width="300" height="{{ category_img_h }}" alt="{{ block.settings.title }}" class="carousel-image" loading="lazy" />
              {% endif %}
              <p class="carousel-title">{{ block.settings.title }}</p>
          {% if block.settings.link %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <button class="carousel-arrow right" onclick="scrollCarousel(this, 1)">&#8250;</button>
  </div>
</div>

<style>
.category-carousel-wrapper {
  padding: 30px 0px;
  text-align: center;
  max-width: 81%;
  margin: auto;
}
.category-carousel-heading {
  font-size: 2em;
  font-weight: 600;
  margin-bottom: 30px;
}
.carousel-container {
  position: relative;
  overflow: hidden;
}
.carousel-track {
  display: flex;
  overflow-x: hidden; /* Oculto en desktop */
  scroll-behavior: smooth;
  gap: 20px;
  padding: 10px 0px;
  scroll-snap-type: x mandatory;
  justify-content: center;
}
.carousel-item {
  flex: 0 0 auto;
  width: 185px;
  scroll-snap-align: start;
  text-align: center;
}
.carousel-image {
  width: 100%;
  border-radius: 12px;
}
.carousel-title {
  margin-top: 10px;
  font-weight: 500;
  font-size: 16px;
}
.carousel-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-100%);
  z-index: 2;
  background: #fceeee;
  border: none;
  border-radius: 50%;
  font-size: 24px;
  width: 40px;
  height: 40px;
  cursor: pointer;
}
.carousel-arrow.left {
  left: 0;
  text-align: center;
}
.carousel-arrow.right {
  right: 0;
  text-align: center;
}
.carousel-item a {
  color: black;
  text-decoration: none;
}
.carousel-item p {
  font-size: 18px;
}

/* Mobile adjustments */
@media screen and (max-width: 768px) {
  .carousel-item {
    width: 120px;
  }
  .carousel-title {
    font-size: 14px;
  }
  .carousel-track {
    overflow-x: auto; /* Aquí habilitamos scroll horizontal con dedo */
    -webkit-overflow-scrolling: touch; /* para scroll suave en iOS */
    justify-content: flex-start;
  }
  .carousel-arrow {
    width: 32px;
    height: 32px;
    font-size: 20px;
  }
}
</style>

<script>
function scrollCarousel(button, direction) {
  const container = button.parentElement.querySelector('.carousel-track');
  const scrollAmount = container.offsetWidth * 0.6;
  container.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
}
</script>
