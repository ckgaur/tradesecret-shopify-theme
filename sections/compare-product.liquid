{%- for block in section.blocks -%}
  {% case block.type %}

    {%- when 'product' -%}
      {%- liquid
        assign compare_media_image = null
        if product.featured_media != blank
          if product.featured_media.media_type == 'image'
            assign compare_media_image = product.featured_media
          elsif product.featured_media.preview_image != blank
            assign compare_media_image = product.featured_media.preview_image
          endif
        endif
      -%}
      <div id="Compare-Product-{{ product.id }}" class="compare-product color-scheme-1 compare-product-modal compare-product-header" data-product-id="{{ product.id }}" data-compare-key="compare-{{ block.type }}">
        {% if block.settings.image_ratio == 'adapt-image' or block.settings.image_ratio == 'custom' %}
          {%- style -%}
            #Compare-Product-{{ product.id }} {
            	{% if block.settings.image_ratio == 'adapt-image' %}
                {% if compare_media_image != blank and compare_media_image.width > 0 %}
                  {% assign aspect_ratio = compare_media_image.height | times: 100 | divided_by: compare_media_image.width %}
                  --image-height: {{ aspect_ratio }}%;
                {% else %}
                  --image-height: 100%;
                {% endif %}
              {% elsif block.settings.image_ratio == 'custom' %}
                --image-height: {{ block.settings.custom_image_height}}%;
            	{% endif %}
            }
          {%- endstyle -%}
        {% endif %}

        <div class="product-media">
          <div class="product-image">
            {% if compare_media_image != blank %}
              <div class="media--{{ block.settings.image_ratio }} media global-media-settings gradient">
                <img
                  src="{{ compare_media_image | image_url: width: 340 }}"
                  alt="{{ compare_media_image.alt | default: product.title | escape }}"
                  width="{{ compare_media_image.width }}"
                  height="{{ compare_media_image.height }}"
                  loading="lazy"
                  fetchpriority="low"
                >
              </div>
            {% endif %}
          </div>
        </div>

        <div class="product-info">
          <h3 class="compare-product-title h5">
            {{ product.title }}
          </h3>

          <div class="compare-product-price">
            {%- render 'price', product: product, use_variant: true, show_badges: false, price_class: '' -%}
          </div>

          <a href="{{ product.url }}" class="button button--{{ settings.compare_banner_button_style }}  button--{{ settings.compare_banner_button_outline }} button--animate-{{ settings.animations_hover_elements }}">
            {{ 'compare_product.view_product' | t }}
          </a>
        </div>

        <span class="remove-compare-product button--animate-{{ settings.animations_hover_elements }}" data-product-id="{{ product.id }}">
          <span class="remove-compare-product__icon">
            {% render 'icon-close' %}
          </span>
        </span>
      </div>

    {%- when 'vendor' -%}
      <div class="compare-product color-scheme-1 compare-product-modal" data-product-id="{{ product.id }}" data-compare-key="compare-{{ block.type }}">
        <div class="inline-richtext compare-label">
          {{ block.settings.label }}
        </div>
        <span>
          {% if product.vendor != blank %}
            {{ product.vendor }}
          {% else %}
            N/A
          {% endif %}
        </span>
      </div>

    {%- when 'type' -%}
      <div class="compare-product color-scheme-1 compare-product-modal" data-product-id="{{ product.id }}" data-compare-key="compare-{{ block.type }}">
        <div class="inline-richtext compare-label">
          {{ block.settings.label }}
        </div>
        <span>
          {% if product.type != blank %}
            {{ product.type }}
          {% else %}
            N/A
          {% endif %}
        </span>
      </div>

    {%- when 'description' -%}
      <div class="compare-product color-scheme-1 compare-product-modal" data-product-id="{{ product.id }}" data-compare-key="compare-{{ block.type }}">
        <div class="inline-richtext compare-label">
          {{ block.settings.label }}
        </div>
        <div class="rte">
          {% if product.description != blank %}
            {{ product.description }}
          {% else %}
            N/A
          {% endif %}
        </div>
      </div>

    {%- when 'sku' -%}
      <div class="compare-product color-scheme-1 compare-product-modal" data-product-id="{{ product.id }}" data-compare-key="compare-{{ block.type }}">
        <div class="inline-richtext compare-label">
          {{ block.settings.label }}
        </div>
        <span>
          {% if product.selected_or_first_available_variant.sku != blank %}
            {{ product.selected_or_first_available_variant.sku }}
          {% else %}
            N/A
          {% endif %}
        </span>
      </div>

    {%- when 'availability' -%}
      <div class="compare-product color-scheme-1 compare-product-modal" data-product-id="{{ product.id }}" data-compare-key="compare-{{ block.type }}">
        <div class="inline-richtext compare-label">
          {{ block.settings.label }}
        </div>
        <span>
          {% if product.available %}
            {{ 'products.product.inventory_in_stock' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </span>
      </div>

    {%- when 'variant_option' -%}
      <div class="compare-product color-scheme-1 compare-product-modal" data-product-id="{{ product.id }}" data-compare-key="compare-{{ block.type }}-{{ forloop.index }}">
        <div class="inline-richtext compare-label">
          {{ block.settings.label }}
        </div>

        <div>
          {%- assign color_label_list = settings.product_variants_name | replace: ', ', ',' | downcase | split: ',' -%}
          {%- assign variant_name = block.settings.variant_name | downcase -%}
          {% if color_label_list contains variant_name %}
            {%- for color_label in color_label_list -%}
              {%- if product.options_by_name[color_label] != blank and color_label == variant_name -%}
                {%- assign product_option = product.options_by_name[color_label] -%}
                <div class="card-variants-wrapp no-js-hidden" data-test="{{ color_label }}">
                  <div class="card-variants">
                    {%- for value in product_option.values -%}
                      <div class="card-variant" role="button" aria-label="Card variant" tabindex="0">
                        <span data-selected-dropdown-swatch="options[{{ product_option.name | escape }}]" class="dropdown-swatch">
                          {% render 'swatch', swatch: value.swatch %}
                        </span>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {% else %}
            {%- for option in product.options_with_values -%}
              {% if option.name == block.settings.variant_name %}
                {%- for value in option.values -%}
                  {{ value -}}
                  {%- unless forloop.last %},{% endunless %}
                {%- endfor -%}
              {% endif %}
            {%- endfor -%}
          {% endif %}
        </div>
      </div>

    {%- when 'metafield' -%}
      <div class="compare-product color-scheme-1 compare-product-modal" data-product-id="{{ product.id }}" data-compare-key="compare-{{ block.type }}-{{ forloop.index }}">
        <div class="inline-richtext compare-label">
          {{ block.settings.label }}
        </div>

        <div class="rte">
          {% assign metafield_value = block.settings.metafield %}
          {% if metafield_value != blank %}
            {{ metafield_value }}
          {% else %}
            N/A
          {% endif %}
        </div>
      </div>
  {% endcase %}
{%- endfor -%}

{% schema %}
{
  "name": "Compare",
  "class": "section-compare hidden",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "product",
      "name": "Header",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "image_ratio",
          "options": [
            {
              "value": "adapt-image",
              "label": "t:sections.featured-collection.settings.image_ratio.options__1.label"
            },
            {
              "value": "portrait",
              "label": "t:sections.featured-collection.settings.image_ratio.options__2.label"
            },
            {
              "value": "square",
              "label": "t:sections.featured-collection.settings.image_ratio.options__3.label"
            },
            {
              "value": "custom",
              "label": "Custom"
            }
          ],
          "default": "adapt-image",
          "label": "t:sections.featured-collection.settings.image_ratio.label"
        },
        {
          "type": "range",
          "id": "custom_image_height",
          "min": 60,
          "max": 120,
          "step": 1,
          "unit": "%",
          "label": "Custom image height",
          "default": 120,
          "visible_if": "{{ block.settings.image_ratio == 'custom' }}"
        }
      ]
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Vendor",
          "label": "Row title"
        }
      ]
    },
    {
      "type": "type",
      "name": "Product type",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Product type",
          "label": "Row title"
        }
      ]
    },
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "label",
          "default": "Product description",
          "label": "Row title"
        }
      ]
    },
    {
      "type": "sku",
      "name": "Product SKU",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Product SKU",
          "label": "Row title"
        }
      ]
    },
    {
      "type": "availability",
      "name": "Availability",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Availability",
          "label": "Row title"
        }
      ]
    },
    {
      "type": "variant_option",
      "name": "Variant option",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Product option",
          "label": "Row title"
        },
        {
          "type": "text",
          "id": "variant_name",
          "default": "Size",
          "label": "Option name"
        }
      ]
    },
    {
      "type": "metafield",
      "name": "Metafield",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Metafield",
          "label": "Row title"
        },
        {
          "type": "richtext",
          "id": "metafield",
          "label": "Custom content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compare"
    }
  ]
}
{% endschema %}