{%- liquid
  assign bg_light_desktop = section.settings.background_image | default: section.settings.background_image_dark_mode
  assign bg_light_mobile = section.settings.background_image_mobile | default: bg_light_desktop
  assign bg_dark_desktop = section.settings.background_image_dark_mode | default: bg_light_desktop
  assign bg_dark_mobile = section.settings.background_image_mobile_dark_mode | default: bg_dark_desktop | default: bg_light_mobile

  assign has_background = false
  if bg_light_desktop != blank or bg_light_mobile != blank
    assign has_background = true
  endif

  assign has_dark_background = false
  if section.settings.background_image_dark_mode != blank or section.settings.background_image_mobile_dark_mode != blank
    assign has_dark_background = true
  endif

  assign is_eager = false
  if section.index == 1
    assign is_eager = true
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .section-layout {
    --spt: {{ section.settings.padding_top | times: 0.1 }}rem; 
    --spb: {{ section.settings.padding_bottom | times: 0.1 }}rem; 
    --spt-mobile: {{ section.settings.padding_top_mb | times: 0.1 }}rem;
    --spb-mobile: {{ section.settings.padding_bottom_mb | times: 0.1 }}rem;
  }

  {% if has_background %}
    .section-layout__background {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      user-select: none;
      overflow: hidden;
      grid-column: 1 / -1;
    }
    .section-layout__background img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      --bg-focal-current: var(--bg-focal-desktop, center);
      object-position: var(--bg-focal-current);
    }
    .section-layout__background img.background--contain {
      object-fit: contain;
    }
    .section-layout__background img.background--cover {
      object-fit: cover;
    }
    @media (max-width: 1024px) {
      .section-layout__background img {
        --bg-focal-current: var(--bg-focal-mobile, var(--bg-focal-desktop, center));
      }
      .section-layout__background img.background--cover-mobile {
        object-fit: cover;
      }
      .section-layout__background img.background--contain-mobile {
        object-fit: contain;
      }
    }
    .content-blocks {
      position: relative;
      z-index: 1;
    }
    .section-layout__background--dark {
      display: none;
    }
    {% if has_dark_background %}
      html[data-color-mode="dark-mode"] #shopify-section-{{ section.id }} .section-layout__background--light {
        display: none;
      }
      html[data-color-mode="dark-mode"] #shopify-section-{{ section.id }} .section-layout__background--dark {
        display: block;
      }
    {% endif %}
  {% endif %}
{% endstyle %}

{{ 'section-with-blocks.css' | asset_url | stylesheet_tag }}


{%- if section.settings.full_width == false -%}
  <div class="page-width">
    <div class="section-container" style="border-radius: {{ section.settings.container_border_radius }}px;">
{%- endif -%}

  <div class="section-content-blocks section-layout{% if section.settings.full_height and section.settings.full_width == true %} layout-full-height{% endif %} gradient color-{{ section.settings.color_scheme }}">

    {%- if has_background -%}
      {% render 'section-background',
        image_desktop: bg_light_desktop,
        image_mobile: bg_light_mobile,
        bg_style: section.settings.background_style,
        bg_style_mobile: section.settings.background_style_mobile,
        eager: is_eager,
        variant: 'light'
      %}

      {%- if has_dark_background -%}
        {% render 'section-background',
          image_desktop: bg_dark_desktop,
          image_mobile: bg_dark_mobile,
          bg_style: section.settings.background_style,
          bg_style_mobile: section.settings.background_style_mobile,
          eager: is_eager,
          variant: 'dark'
        %}
      {%- endif -%}
    {%- endif -%}

    <div class="content-blocks-container page-width">
      <div class="content-blocks content-blocks--vertical-{{ section.settings.vertical_alignment }}">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>

{%- if section.settings.full_width == false -%}
    </div>
  </div>
{%- endif -%}

