<style>
  header-drawer {
    justify-self: start;
		margin-left: -.5rem;
  }

	@media screen and (max-width: 749px) {
		header-drawer {
			margin-left: 0;
		}
	}

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: 1.375;
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: 1.8;
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top_mb }}px 1.5rem {{ section.settings.padding_bottom_mb }}px 1.5rem;
  }

  .section-header {
		--counter-foreground: {{ section.settings.counter_color }};
		--counter-bg: {{ section.settings.counter_bg }};
		--logo-width: {{ settings.logo_width }}px;

    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
{%- if settings.cart_type == "drawer" -%}
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<svg xmlns="http://www.w3.org/2000/svg" class="hidden">
	<symbol id="icon-search" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
		{% comment %} <path d="M16.927 17.04L20.4001 20.4M19.2801 11.44C19.2801 15.7699 15.77 19.28 11.4401 19.28C7.11019 19.28 3.6001 15.7699 3.6001 11.44C3.6001 7.11006 7.11019 3.59998 11.4401 3.59998C15.77 3.59998 19.2801 7.11006 19.2801 11.44Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/> {% endcomment %}
		<path id="Icon" d="M16.9268 17.0401L20.4 20.4001M19.28 11.4401C19.28 15.77 15.7699 19.2801 11.44 19.2801C7.11006 19.2801 3.59998 15.77 3.59998 11.4401C3.59998 7.11019 7.11006 3.6001 11.44 3.6001C15.7699 3.6001 19.28 7.11019 19.28 11.4401Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
	</symbol>

  <symbol id="icon-reset" class="icon icon-close"  fill="none" viewBox="0 0 18 18" stroke="currentColor">
    <circle r="8.5" cy="9" cx="9" stroke-opacity="0.2"/>
    <path d="M6.82972 6.82915L1.17193 1.17097" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
    <path d="M1.22896 6.88502L6.77288 1.11523" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
  </symbol>

  <symbol id="icon-close" class="icon icon-close" fill="none" viewBox="0 0 18 17">
    <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
  </symbol>
</svg>


{%- liquid
	assign is_language_localization = false
	assign is_country_localization = false
	if section.settings.enable_language_selector and localization.available_languages.size > 1
		assign is_language_localization = true
	endif
	if section.settings.enable_country_selector and localization.available_countries.size > 1
		assign is_country_localization = true
	endif

  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor

	assign transparent_header = false
	assign pages_transparent_header = section.blocks | where: 'type', 'pages_transparent_header' | first

	if pages_transparent_header and pages_transparent_header.settings.pages != blank and section.settings.sticky_header_type != 'none' 
		for link in pages_transparent_header.settings.pages.links
			if link.current 
				assign transparent_header = true
			endif
		endfor
	endif
-%}

<{% if section.settings.sticky_header_type != 'none' %}sticky-header data-sticky-type="{{ section.settings.sticky_header_type }}"{% else %}div{% endif %} class="header-wrapper color-{{ section.settings.color_scheme }} gradient {% if section.settings.search_type == "inline" or section.settings.search_type == "inline_filter" %} header--inline-search {% if section.settings.search_type == "inline_filter" %} header--inline-filter-search{% endif %}{% endif %}{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %} {% if transparent_header == true %} header-transparent {% endif %} header-at-top">
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}
  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %} {% if transparent_header == true %} header--transparent {% endif %}">
    {%- liquid
      if section.settings.menu != blank
        render 'header-drawer'
      endif
    -%}

    {%- if section.settings.logo_position != 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
          <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
            {%- if settings.logo != blank -%}
              <div class="header__heading-logo-wrapper">
                {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
                {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
                {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
                {{ settings.logo | image_url: width: 600 | image_tag:
                  class: 'header__heading-logo motion-reduce',
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes,
                  preload: true
                }}
              </div>
            {%- else -%}
              <span class="h5">{{ shop.name }}</span>
            {%- endif -%}
          </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    {%- liquid
			assign show_search = false
			if section.settings.logo_position == 'top-left' and section.settings.search_type != 'popup'
				assign show_search = true
			endif
			if section.settings.logo_position == 'middle-left' and section.settings.search_type != 'popup'
				assign show_search = true
			endif
			if section.settings.logo_position == 'middle-center' and section.settings.search_type != 'popup'
				assign show_search = true
			endif

      if show_search or section.settings.logo_position == 'top-center' or  section.settings.menu == blank
        render 'header-search', input_id: 'Search-In-Modal-1', search_type: section.settings.search_type
      endif
    -%}

		{%- if section.settings.menu != blank and section.settings.menu_type_desktop != 'drawer' and section.settings.logo_position != 'top-left' -%}

			<nav class="header__inline-menu">
				<ul class="list-menu list-menu--inline {{ section.settings.text_weight }}" role="list">
					{%- for link in section.settings.menu.links -%}
						{% liquid
							assign mm_type = 'default'
							assign current_collection_block = nil
							assign current_collection_list_block = nil

							assign collection_blocks = section.blocks | where: "type", "mm_collection"
							assign is_collection_type = false

							for block in collection_blocks
								if block.settings.menu_item == link.title
									assign is_collection_type = true
									assign current_collection_block = block
								endif
							endfor

							if current_collection_block != blank and is_collection_type
								assign mm_type = 'collection'
							endif

							assign collection_list_blocks = section.blocks | where: "type", "mm_collection_list"
							assign is_collection_list_type = false

							for block in collection_list_blocks
								if block.settings.menu_item == link.title
									assign is_collection_list_type = true
									assign current_collection_list_block = block
								endif
							endfor

							if current_collection_list_block != blank and is_collection_list_type
								assign mm_type = 'collection_list'
							endif
						%}

						<li>
							{%- if link.links != blank -%}	
								{% liquid
									assign hasSubSubMenu = false
									assign hasDrawerMenu = link.title
									for childlink in link.links
										if childlink.links != blank
											assign hasSubSubMenu = true
										endif
									endfor
								%}					
									{% if section.settings.menu_type_desktop == 'mega' and hasSubSubMenu == true %}
										{% render 'header-mega-menu', 
											link: link,
											mm_type: mm_type,
											collection_block: current_collection_block,
											collection_list_block: current_collection_list_block
										%}
									{% elsif section.settings.menu_type_desktop == 'mega' and hasSubSubMenu == false %}
											{% render 'header-dropdown-menu', link: link %}
									{% elsif section.settings.menu_type_desktop == 'dropdown' %}
										{% render 'header-dropdown-menu', link: link %}
									{% endif %}						
							{%- else -%}
								<a
									id="HeaderMenu-{{ link.handle }}"
									href="{{ link.url }}"
									class="header__menu-item list-menu__item link link--text focus-inset"
									{% if link.current %}
										aria-current="page"
									{% endif %}
								>
									<span
										{%- if link.current %}
											class="header__active-menu-item"
										{% endif %}
									>
										{{- link.title | escape -}}
									</span>
								</a>							
							{%- endif -%}
						</li>	
					{%- endfor -%}
				</ul>
			</nav>
		{%- endif -%}

    {%- if section.settings.logo_position == 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
          <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
            {%- if settings.logo != blank -%}
              <div class="header__heading-logo-wrapper">
                {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
                {% capture sizes %}(min-width: 750px) {{ settings.logo_width }}px, 50vw{% endcapture %}
                {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
                {{ settings.logo | image_url: width: 600 | image_tag:
                  class: 'header__heading-logo',
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes,
                  preload: true
                }}
              </div>
            {%- else -%}
              <span class="h2">{{ shop.name }}</span>
            {%- endif -%}
          </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    

    <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">

			{%- if is_language_localization or is_country_localization -%}
				<div class="desktop-localization-wrapper">
					{%- if is_language_localization -%}
						<noscript class="small-hide medium-hide">
							{%- form 'localization', id: 'HeaderLanguageMobileFormNoScript', class: 'localization-form' -%}
								<div class="localization-form__select">
									<h2 class="visually-hidden" id="HeaderLanguageMobileLabelNoScript">{{ 'localization.language_label' | t }}</h2>
									<select class="localization-selector link" name="locale_code" aria-labelledby="HeaderLanguageMobileLabelNoScript">
										{%- for language in localization.available_languages -%}
											<option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {%- if language.iso_code == localization.language.iso_code %} selected{% endif %}>
												{{ language.endonym_name | capitalize }}
											</option>
										{%- endfor -%}
									</select>
									{% render 'icon-caret' %}
								</div>
								<button class="button button--tertiary">{{ 'localization.update_language' | t }}</button>
							{%- endform -%}
						</noscript>

						<localization-form class="localization-form--lang small-hide medium-hide no-js-hidden" data-prevent-hide>
							{%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
								<div>
									<h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
									{%- render 'language-localization', localPosition: 'HeaderLanguage', popup_scheme: section.settings.menu_color_scheme, text_weight: section.settings.text_weight -%}
								</div>
							{%- endform -%}
						</localization-form>
					{%- endif -%}

					{%- if is_country_localization -%}
						<noscript class="small-hide medium-hide">
							{%- form 'localization', id: 'HeaderCountryMobileFormNoScript', class: 'localization-form' -%}
								<div class="localization-form__select">
									<h2 class="visually-hidden" id="HeaderCountryMobileLabelNoScript">{{ 'localization.country_label' | t }}</h2>
									<select class="localization-selector link" name="country_code" aria-labelledby="HeaderCountryMobileLabelNoScript">
										{%- for country in localization.available_countries -%}
											<option value="{{ country.iso_code }}" {%- if country.iso_code == localization.country.iso_code %} selected{% endif %}>
												{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
											</option>
										{%- endfor -%}
									</select>
									{% render 'icon-caret' %}
								</div>
								<button class="button button--tertiary">{{ 'localization.update_country' | t }}</button>
							{%- endform -%}
						</noscript>

						<localization-form class="localization-form--country small-hide medium-hide no-js-hidden" data-prevent-hide>
							{%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
								<div>
									<h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
									{%- render 'country-localization', localPosition: 'HeaderCountry', popup_scheme: section.settings.menu_color_scheme, text_weight: section.settings.text_weight -%}
								</div>
							{%- endform -%}
						</localization-form>
					{% endif %}
				</div>	
			{%- endif -%}

			{% liquid
				assign show_search = false

				if section.settings.logo_position == 'top-left' and section.settings.search_type == 'popup'
					assign show_search = true
				endif
			%}
			{%- if  show_search or section.settings.logo_position != 'top-left' -%}
				{% render 'header-search', input_id: 'Search-In-Modal', search_type: section.settings.search_type %}
			{%- endif -%}

                 <!--a href="https://docs.google.com/forms/d/e/1FAIpQLSdjtB4alZbRmazNZAmpgYjxRkyDG2b47pwgGG1HKt-xAoejTw/viewform" class="salon-booking-button">
                  <span class="icon-calendar">
                    <img src="https://cdn.shopify.com/s/files/1/0757/6220/4905/files/Vector.png?v=1753860795" alt="Calendar Icon" width="18" height="18">
                  </span>
                  <span class="text">Book a Salon Service</span>
                  <span class="icon-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" stroke="red" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                      <polyline points="9 18 15 12 9 6" />
                    </svg>
                  </span>
                </a-->

      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide medium-hide {% endif %}">

					{%- if section.settings.login_label != blank -%}
						<span class="header__icon-wrapper">
					{%- endif -%}
          {% render 'icon-account' %}
					{%- if section.settings.login_label != blank -%}
						</span>
					{%- endif -%}

					{%- if section.settings.login_label != blank -%}
						<span class="header__icon-label link-underline fw-500">
							{{ section.settings.login_label }}
						</span>
					{%- endif -%}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}

{% comment %}
{%- if shop.customer_accounts_enabled -%}
  <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide medium-hide {% endif %}">
    <span class="header__icon-wrapper">
      {% render 'icon-account' %}
    </span>
    <span class="header__icon-label link-underline fw-500">
      {%- if customer -%}
        My Account
      {%- else -%}
        Sign in for free shipping
      {%- endif -%}
    </span>
    <span class="visually-hidden">
      {%- if customer -%}
        {{ 'customer.account_fallback' | t }}
      {%- else -%}
        {{ 'customer.log_in' | t }}
      {%- endif -%}
    </span>
  </a>
{%- endif -%}
 {% endcomment %}


      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
	  
      
<button class="st-wishlist-button" data-type="details" onclick="window.location.href='/pages/my-wishlist'">
</button>
			
			<a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset color-{{ section.settings.cart_color_scheme}} {% if template == 'cart' %} hidden {%  endif %}" id="cart-icon-bubble">
				{%- liquid
					if cart == empty
						render 'icon-cart-empty'
					else
						render 'icon-cart'
					endif
				-%}
				<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
				{%- if cart != empty -%}
					<div class="cart-count-bubble {% if cart.item_count > 100 %} hidden{% endif %}">
						{%- if cart.item_count < 100 -%}
							<span aria-hidden="true">{{ cart.item_count }}</span>
						{%- endif -%}
						<span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
					</div>
				{%- endif -%}
			</a>

                        
    </div>

                 

		{%- if section.settings.menu != blank and section.settings.menu_type_desktop != 'drawer' and section.settings.logo_position == 'top-left' -%}

			<nav class="header__inline-menu">
				<ul class="list-menu list-menu--inline {{ section.settings.text_weight }}" role="list">
					{%- for link in section.settings.menu.links -%}
						{% liquid
							assign mm_type = 'default'
							assign current_collection_block = nil
							assign current_collection_list_block = nil

							assign collection_blocks = section.blocks | where: "type", "mm_collection"
							assign is_collection_type = false

							for block in collection_blocks
								if block.settings.menu_item == link.title
									assign is_collection_type = true
									assign current_collection_block = block
								endif
							endfor

							if current_collection_block != blank and is_collection_type
								assign mm_type = 'collection'
							endif

							assign collection_list_blocks = section.blocks | where: "type", "mm_collection_list"
							assign is_collection_list_type = false

							for block in collection_list_blocks
								if block.settings.menu_item == link.title
									assign is_collection_list_type = true
									assign current_collection_list_block = block
								endif
							endfor

							if current_collection_list_block != blank and is_collection_list_type
								assign mm_type = 'collection_list'
							endif
						%}

						<li>
							{%- if link.links != blank -%}	
								{% liquid
									assign hasSubSubMenu = false
									assign hasDrawerMenu = link.title
									for childlink in link.links
										if childlink.links != blank
											assign hasSubSubMenu = true
										endif
									endfor
								%}					
									{% if section.settings.menu_type_desktop == 'mega' and hasSubSubMenu == true  %}
										{% render 'header-mega-menu', 
											link: link,
											mm_type: mm_type,
											collection_block: current_collection_block,
											collection_list_block: current_collection_list_block
										%}
									{% elsif section.settings.menu_type_desktop == 'mega' and hasSubSubMenu == false %}

										{% liquid
											assign mm_type = 'default'
											assign current_collection_block = nil
											assign current_collection_list_block = nil

											assign collection_blocks = section.blocks | where: "type", "mm_collection"
											assign is_collection_type = false

											for block in collection_blocks
												if block.settings.menu_item == link.title
													assign is_collection_type = true
													assign current_collection_block = block
												endif
											endfor

											if current_collection_block != blank and is_collection_type
												assign mm_type = 'collection'
											endif

											assign collection_list_blocks = section.blocks | where: "type", "mm_collection_list"
											assign is_collection_list_type = false

											for block in collection_list_blocks
												if block.settings.menu_item == link.title
													assign is_collection_list_type = true
													assign current_collection_list_block = block
												endif
											endfor

											if current_collection_list_block != blank and is_collection_list_type
												assign mm_type = 'collection_list'
											endif
										%}

										{% if mm_type == 'collection' or mm_type == 'collection_list' %}
											{% render 'header-mega-menu', 
												link: link,
												mm_type: mm_type,
												collection_block: current_collection_block,
												collection_list_block: current_collection_list_block
											%}
										{% else %}
											{% render 'header-dropdown-menu', link: link %}
										{% endif %}
									{% elsif section.settings.menu_type_desktop == 'dropdown' %}
										{% render 'header-dropdown-menu', link: link %}
									{% endif %}						

							{%- else -%}
								{% liquid
									assign mm_type = 'default'
									assign current_collection_block = nil
									assign current_collection_list_block = nil

									assign collection_blocks = section.blocks | where: "type", "mm_collection"
									assign is_collection_type = false

									for block in collection_blocks
										if block.settings.menu_item == link.title
											assign is_collection_type = true
											assign current_collection_block = block
										endif
									endfor

									if current_collection_block != blank and is_collection_type
										assign mm_type = 'collection'
									endif

									assign collection_list_blocks = section.blocks | where: "type", "mm_collection_list"
									assign is_collection_list_type = false

									for block in collection_list_blocks
										if block.settings.menu_item == link.title
											assign is_collection_list_type = true
											assign current_collection_list_block = block
										endif
									endfor

									if current_collection_list_block != blank and is_collection_list_type
										assign mm_type = 'collection_list'
									endif
								%}

								{% if mm_type == 'collection' or mm_type == 'collection_list' %}
									{% render 'header-mega-menu', 
										link: link,
										mm_type: mm_type,
										collection_block: current_collection_block,
										collection_list_block: current_collection_list_block
									%}
								{% else %}
									<a
										id="HeaderMenu-{{ link.handle }}"
										href="{{ link.url }}"
										class="header__menu-item list-menu__item link link--text focus-inset"
										{% if link.current %}
											aria-current="page"
										{% endif %}
									>
										<span
											{%- if link.current %}
												class="header__active-menu-item"
											{% endif %}
										>
											{{- link.title | escape -}}
										</span>
									</a>
								{% endif %}
							{%- endif -%}
						</li>	
					{%- endfor -%}
				</ul>
			</nav>
		{%- endif -%}
    </header>
                  <div class="booking-mobile">     
                  <a href="https://docs.google.com/forms/d/e/1FAIpQLSdjtB4alZbRmazNZAmpgYjxRkyDG2b47pwgGG1HKt-xAoejTw/viewform" class="salon-booking-button-mobile">
                  <span class="icon-calendar">
                    <img src="https://cdn.shopify.com/s/files/1/0757/6220/4905/files/Vector.png?v=1753860795" alt="Calendar Icon" width="18" height="18">
                  </span>
