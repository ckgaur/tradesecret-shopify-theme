{% schema %}
{
  "name": "Product Promo Banners",
  "tag": "section",
  "class": "product-promo-section",
  "settings": [],
  "blocks": [
    {
      "type": "promo",
      "name": "Promo Banner",
      "settings": [
        {
          "type": "text",
          "id": "discount_text",
          "label": "Discount Text",
          "default": "25% Off"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "On Kerasilk Products"
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Brand Logo"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "SHOP NOW"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#FDE4C3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Promo Banners",
      "blocks": [
        {
          "type": "promo",
          "settings": {
            "discount_text": "25% Off",
            "heading": "On Kerasilk Products",
            "button_label": "SHOP NOW"
          }
        },
        {
          "type": "promo",
          "settings": {
            "discount_text": "25% Off",
            "heading": "On Framesi Milan Products",
            "button_label": "SHOP NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.product-promo-section {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  max-width: 100%;
  width: 100%;
  padding: 5rem;
  overflow: hidden;
}

.product-promo-link {
  display: block;
  flex: 1;
  text-decoration: none;
  color: inherit;
}

.product-promo {
  flex: 1;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  border-radius: 12px;
  overflow: hidden;
  min-height: 280px;
  transition: all 0.2s ease;
}

.product-promo-link:hover .product-promo {
  opacity: 0.95;
  transform: translateY(-2px);
}

.promo-content {
  max-width: 40%;
  padding: 25px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.promo-content h3 {
  font-size: 20px;
  margin: 0;
  color: #ff4a4a;
  font-weight: 600;
}

.promo-content h2 {
  font-size: 30px;
  margin: 10px 0;
  font-weight: 600;
}

.promo-logo {
  width: 100%;
  margin: 20px 0;
}

.promo-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: bold;
  text-decoration: none;
  text-transform: uppercase;
  color: #000;
  font-size: 14px;
}

.promo-button::after {
  content: '›';
  font-size: 18px;
  margin-left: 8px;
  position: relative;
  top: -1px;
}  

.promo-image {
  flex: 1;
  display: flex;
  align-items: stretch;
}

.promo-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 0;
}
{% endstylesheet %}

{% for block in section.blocks %}
  {% assign promo_link = block.settings.button_link %}
  {% if promo_link != blank %}
    <a href="{{ promo_link }}" class="product-promo-link">
  {% endif %}

    <div class="product-promo" style="background-color: {{ block.settings.bg_color }};">
      <div class="promo-content">
        <h3>{{ block.settings.discount_text }}</h3>
        <h2>{{ block.settings.heading }}</h2>
        {% if block.settings.logo_image %}
          <div class="promo-logo">
            <img src="{{ block.settings.logo_image | image_url: width: 200 }}" alt="Brand Logo">
          </div>
        {% endif %}
        {% if block.settings.button_label %}
          <span class="promo-button">{{ block.settings.button_label | upcase }}</span>
        {% endif %}
      </div>
      <div class="promo-image">
        {% if block.settings.product_image %}
          <img src="{{ block.settings.product_image | image_url: width: 400 }}" alt="Product Image">
        {% endif %}
      </div>
    </div>

  {% if promo_link != blank %}
    </a>
  {% endif %}
{% endfor %}
