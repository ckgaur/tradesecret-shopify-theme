<section class="stores-list-section">
  <div class="stores-wrapper">
    {% for block in section.blocks %}
      <div class="store-card">
        <div class="store-info">
          {% if block.settings.store_image != blank %}
            <img src="{{ block.settings.store_image | img_url: 'medium' }}" alt="{{ block.settings.store_name }}">
          {% endif %}
          <div class="store-details">
            <h2>{{ block.settings.store_name }}</h2>
            <p>{{ block.settings.store_address }}</p>
            <p>{{ block.settings.store_city }}</p>
            <p>{{ block.settings.store_country }}</p>
            <details class="store-contact">
              <summary>About and Contact &#8250;</summary>
              <div class="contact-info">
                {% if block.settings.phone != blank %}
                  <p>📞 {{ block.settings.phone }}</p>
                {% endif %}
                {% if block.settings.email != blank %}
                  <p>📧 {{ block.settings.email }}</p>
                {% endif %}
              </div>
            </details>
          </div>
        </div>
        <div class="store-hours">
          <ul class="hours-list">
            <li><span class="day">Mon.</span><span class="hours">{{ block.settings.mon_hours }}</span></li>
            <li><span class="day">Tue.</span><span class="hours">{{ block.settings.tue_hours }}</span></li>
            <li><span class="day">Wed.</span><span class="hours">{{ block.settings.wed_hours }}</span></li>
            <li><span class="day">Thu.</span><span class="hours">{{ block.settings.thu_hours }}</span></li>
            <li><span class="day">Fri.</span><span class="hours">{{ block.settings.fri_hours }}</span></li>
            <li><span class="day">Sat.</span><span class="hours">{{ block.settings.sat_hours }}</span></li>
            <li><span class="day">Sun.</span><span class="hours">{{ block.settings.sun_hours }}</span></li>
          </ul>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .store-card {
    border-bottom: 1px solid #eee;
    padding: 20px 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }
  .store-info {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    flex: 1 1 45%;
  }
  .store-info img {
    max-width: 150px;
    height: auto;
    border-radius: 5px;
  }
  .store-details h2 {
    margin: 0 0 10px;
  }
  .store-hours {
    flex: 1 1 30%;
  }
  .hours-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .hours-list li {
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    margin-bottom: 4px;
  }
  .hours-list .day {
    font-weight: bold;
    width: 60px;
  }
  .hours-list .hours {
    flex: 1;
    text-align: left;
  }
  .store-contact summary {
    font-weight: bold;
    margin-top: 10px;
    cursor: pointer;
    list-style: none;
  }
  .store-contact[open] summary {
    color: #c00;
  }
  .store-contact summary::-webkit-details-marker {
    display: none;
  }
  .contact-info {
    margin-top: 10px;
    padding-left: 10px;
  }
  @media (max-width: 991px) {
    .store-card {
      flex-direction: row;
    }

    .store-info {
      flex-direction: column;
      flex: 1 1 35%;
    }

    .store-info img {
      max-width: 100%;
      height: auto;
    }

    .store-hours {
      margin-top: 20px;
    }

    .hours-list li {
      font-size: 15px;
    }
  }

  @media (max-width: 600px) {
    .store-details h2 {
      font-size: 1.1em;
    }

    .hours-list li {
      font-size: 14px;
    }

    .store-card {
      padding: 16px 0;
    }

    .stores-wrapper {
      padding: 0 12px;
    }
    .hours-list .day{
    width: 40px;
  }
  }
</style>

