{% schema %}
{
  "name": "Brands List",
  "max_blocks": 60,
  "settings": [],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Brand Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brands List",
      "category": "Custom"
    }
  ]
}
{% endschema %}




<section class="brands-list-section">

  <!-- Brand Grid -->
  <div class="brands-list-wrapper">
    {% assign sorted_blocks = section.blocks | sort: "settings.collection" %}
    {% assign previous_letter = "" %}

    {% for block in sorted_blocks %}
      {% assign collection = collections[block.settings.collection] %}
      {% if collection %}
        {% assign current_letter = collection.title | slice: 0 | upcase %}

        <!-- Add letter heading once per group -->
        {% if current_letter != previous_letter %}
          <h2 class="brand-letter-heading" id="brand-{{ current_letter }}">{{ current_letter }}</h2>
          {% assign previous_letter = current_letter %}
        {% endif %}

        <!-- Brand card -->
        <div class="brand-card">
          <div class="brand-image">
            {% if block.settings.image %}
              <a href="{{ collection.url }}">
                {%- assign brand_img_h = 240 -%}
                {%- if block.settings.image.aspect_ratio -%}{%- assign brand_img_h = 240 | divided_by: block.settings.image.aspect_ratio -%}{%- endif -%}
                <img src="{{ block.settings.image | img_url: 'medium' }}" width="240" height="{{ brand_img_h }}" alt="{{ collection.title }}" loading="lazy">
              </a>
            {% endif %}
          </div>
          <div class="brand-content">
            <h3><a href="{{ collection.url }}">{{ collection.title }}</a></h3>
            <p><a href="{{ collection.url }}">{{ collection.products_count }} products</a></p>
          </div>
          <div class="brand-button-wrapper">
            <a href="{{ collection.url }}" class="brand-button">View Products</a>
          </div>
        </div>

      {% endif %}
    {% endfor %}
  </div>
</section>

<!-- Styles for Brand List -->
<style>
.brands-list-wrapper {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  max-width: 90%;
  margin: 40px auto;
}

.brand-letter-heading {
  font-size: 28px;
  font-weight: bold;
  margin: 60px 0 20px;
  border-bottom: 2px solid #ddd;
  padding-bottom: 5px;
  grid-column: 1 / -1;
}

.brand-card {
  border: 1px solid #ddd;
  padding: 20px;
  background: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.brand-image img {
  width: 100px;
  height: auto;
  object-fit: contain;
}

.brand-content h3 {
  margin: 10px 0 5px;
  font-size: 20px;
}

.brand-content p {
  margin: 0;
  font-size: 14px;
}

.brand-button-wrapper {
  margin-top: 15px;
}

.brand-button {
  background-color: black;
  color: white;
  padding: 10px 20px;
  font-weight: bold;
  text-decoration: none;
  display: none;
}

/* Underline animation */
.brand-content a {
  color: inherit;
  text-decoration: none;
  position: relative;
}

.brand-content a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 4px;
  width: 100%;
  height: 2px;
  background-color: currentColor;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}

.brand-content a:hover::after {
  transform: scaleX(1);
}

/* Responsive */
@media (max-width: 1024px) {
  .brands-list-wrapper {
    grid-template-columns: repeat(2, 1fr);
    width: 100%;
  }
}

@media (max-width: 600px) {
  .brands-list-wrapper {
    grid-template-columns: repeat(2, 1fr);
    width: 100%;
  }
}
</style>
