EEN MODAL ---- *\/\n.video-modal {\n  position: fixed;\n  inset: 0;\n  background: rgba(0,0,0,0.9);\n  display: none;\n  justify-content: center;\n  align-items: center;\n  z-index: 99999;\n}\n\n.video-modal video {\n  width: 90%;\n  max-width: 800px;\n  border-radius: 12px;\n}\n\n.video-modal .close-modal {\n  position: absolute;\n  top: 20px;\n  right: 20px;\n  font-size: 32px;\n  color: #fff;\n  cursor: pointer;\n}\n<\/style>\n\n<div class=\"videos-grid\">\n  <div class=\"video-item\">\n    <video autoplay loop muted playsinline>\n      <source src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/c56ace1abbf24b3997ffb863e85bdfa9.mp4\" type=\"video\/mp4\">\n    <\/video>\n  <\/div>\n\n  <div class=\"video-item\">\n    <video autoplay loop muted playsinline>\n      <source src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/d4585ab811ee4937b656ae434ee0dfbd.mp4\" type=\"video\/mp4\">\n    <\/video>\n  <\/div>\n\n  <div class=\"video-item\">\n    <video autoplay loop muted playsinline>\n      <source src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/cc36c2b31ce345cca6fc48aab9a92293.mp4\" type=\"video\/mp4\">\n    <\/video>\n  <\/div>\n\n  <div class=\"video-item\">\n    <video autoplay loop muted playsinline>\n      <source src=\"https:\/\/cdn.shopify.com\/videos\/c\/o\/v\/2897dab79fd74130824e0bc99758fa3a.mp4\" type=\"video\/mp4\">\n    <\/video>\n  <\/div>\n<\/div>\n\n<!-- FULLSCREEN MODAL -->\n<div class=\"video-modal\" id=\"videoModal\">\n  <span class=\"close-modal\" onclick=\"closeVideoModal()\">✕<\/span>\n  <video id=\"modalVideo\" autoplay loop muted playsinline><\/video>\n<\/div>\n\n<script>\nconst modal = document.getElementById(\"videoModal\");\nconst modalVideo = document.getElementById(\"modalVideo\");\n\ndocument.querySelectorAll(\".videos-grid video\").forEach(v => {\n  v.addEventListener(\"click\", () => {\n    modal.style.display = \"flex\";\n    modalVideo.src = v.querySelector(\"source\").src;\n  });\n});\n\nfunction closeVideoModal() {\n  modal.style.display = \"none\";\n  modalVideo.src = \"\";\n}\n<\/script>\n<script>\ndocument.querySelectorAll(\".videos-grid video\").forEach(video => {\n  video.playbackRate = 0.6;   \/\/ velocidad: 0.5 = la mitad, 1 = normal, 2 = doble\n});\n\nmodalVideo.playbackRate = 0.6; \/\/ también para el video del modal\n<\/script>"}},"collapsible_tab_qX3Fhx":{"type":"collapsible_tab","settings":{"space":"mb-2_4 mb-lg-2_4","heading":"Shipping","icon":"truck","content":"<p>Orders are processed within 1 business day. Once your order is dispatched it takes between 1–3 business days to deliver depending on your shipping address.<\/p><ul><li><strong>FREE SHIPPING<\/strong> on all orders over $39.99 CAD (before taxes).<\/li><li>Orders under $39.99 CAD are subject to a flat-rate shipping fee of $9.99 CAD.<\/li><\/ul><p><a href=\"\/pages\/delivery\" target=\"_blank\" title=\"Shipping Policy\">Learn more<\/a><\/p>","page":""}},"collapsible_tab_caRJwh":{"type":"collapsible_tab","settings":{"space":"mb-2_4 mb-lg-2_4","heading":"Return Policy","icon":"return","content":"<ul><li>Returns must be arranged with us within 30 days of the date of purchase via <a href=\"\/pages\/contact\" target=\"_blank\" title=\"Contact\">Contact Us<\/a> form.<\/li><li>Refunds will only be issued if the product is unused, in its original packaging, and in sellable condition.<\/li><\/ul><p><a href=\"\/pages\/refund-exchange-policy\" target=\"_blank\" title=\"Refund & Exchange Policy\">Learn more<\/a><\/p><p><\/p>","page":""}},"share_RdKeKa":{"type":"share","settings":{"space":"mb-2_4 mb-lg-2_4","share_label":"Share","show_linkedin_share":false,"show_fb_share":true,"show_twitter_share":true,"show_pinterest_share":true,"show_telegram_share":false,"show_snapchat_share":false,"show_tumblr_share":false}}},"block_order":["title","judge_me_reviews_preview_badge_QbQgRE","price","custom_liquid_HgqCGP","text_gBfzeA","variant_picker","aov_ai_bundle_offer_bundle_builder_7GJ8FG","aov_ai_bundle_mix_match_offer_inline_D4gDqL","hitsy_prog