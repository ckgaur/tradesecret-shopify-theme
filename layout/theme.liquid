<script>
(function () {
  var STORAGE_KEY = 'ts_geo_popup_dismissed';
  var DISMISS_DAYS = 30;

  function isDismissed() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      var expires = parseInt(raw, 10);
      return Date.now() < expires;
    } catch (e) { return false; }
  }

  function setDismissed() {
    try {
      var expires = Date.now() + DISMISS_DAYS * 24 * 60 * 60 * 1000;
      localStorage.setItem(STORAGE_KEY, String(expires));
    } catch (e) {}
  }

  function showPopup() {
    var el = document.getElementById('us-redirect-popup');
    if (!el) return;
    el.style.display = 'block';
    document.body.style.overflow = 'hidden';
  }

  function hidePopup() {
    var el = document.getElementById('us-redirect-popup');
    if (!el) return;
    el.style.display = 'none';
    document.body.style.overflow = '';
  }

  function init() {
    if (isDismissed()) return;

    fetch('/browsing_context_suggestions.json', { credentials: 'same-origin' })
      .then(function (res) { return res.ok ? res.json() : null; })
      .then(function (data) {
        console.log('[US redirect popup] geolocation response:', data);

        if (!data || !data.detected_values) {
          console.log('[US redirect popup] no detected_values in response — popup will not show');
          return;
        }

        var dv = data.detected_values;
        var code = (dv.country && (dv.country.handle || dv.country.iso_code)) ||
                    dv.country_code || null;
        var name = (dv.country && dv.country.name) || dv.country_name || null;

        var isCanada = code === 'CA' || name === 'Canada';
        var detectedSomething = !!(code || name);

        console.log('[US redirect popup] detected country code:', code, '| name:', name, '| will show popup:', (detectedSomething && !isCanada));

        if (detectedSomething && !isCanada) {
          showPopup();
        }
      })
      .catch(function (err) {
        console.log('[US redirect popup] geolocation fetch failed:', err);
        // Fail silently — if geolocation lookup fails, no popup is shown
      });
  }

  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('us-redirect-close').addEventListener('click', function () {
      setDismissed();
      hidePopup();
    });
    document.getElementById('us-redirect-stay').addEventListener('click', function () {
      setDismissed();
      hidePopup();
    });
    document.getElementById('us-redirect-overlay').addEventListener('click', function () {
      setDismissed();
      hidePopup();
    });
    document.getElementById('us-redirect-continue').addEventListener('click', function () {
      setDismissed();
    });

    init();
  });
})();
</script>

<script
  src="{{ 'lazy-sections.js' | asset_url }}"
  defer>
</script>
<script>
(function () {
  'use strict';

  const main = document.querySelector('#MainContent');

  if (!main) return;

  const sections = Array.from(
    main.querySelectorAll(':scope > section.shopify-section')
  );

  const INITIAL_SECTIONS = 3;

  sections.forEach((section, index) => {

    // First 3 sections load normally
    if (index < INITIAL_SECTIONS) {
      return;
    }

    // Sections after first 3
    section.classList.add('lazy-section');

    // Browser-level optimization
    section.style.contentVisibility = 'auto';
    section.style.containIntrinsicSize = '800px';

    // Lazy load images
    section.querySelectorAll('img').forEach(img => {
      img.loading = 'lazy';
      img.decoding = 'async';
    });

    // Lazy load iframes
    section.querySelectorAll('iframe').forEach(iframe => {
      iframe.loading = 'lazy';
    });
  });


  /*
   * Initialize section when user gets close to it.
   */
  const observer = new IntersectionObserver(
    function (entries, observer) {

      entries.forEach(function (entry) {

        if (!entry.isIntersecting) return;

        const section = entry.target;

        section.classList.add('lazy-section-loaded');

        /*
         * Notify custom section scripts.
         */
        section.dispatchEvent(
          new CustomEvent('shopify:section:visible', {
            bubbles: true,
            detail: {
              sectionId: section.id
            }
          })
        );

        observer.unobserve(section);
      });

    },
    {
      rootMargin: '600px 0px',
      threshold: 0
    }
  );


  sections.forEach(function (section, index) {

    if (index >= INITIAL_SECTIONS) {
      observer.observe(section);
    }

  });

})();
</script>


