<script>
	document.querySelectorAll('details.mega-menu > summary').forEach(summary => {
  summary.addEventListener('click', function(e) {
    const details = this.parentElement;
    const url = this.getAttribute('data-url');

    if (!details.hasAttribute('data-opened')) {
      // First click → open dropdown only
      e.preventDefault();
      details.setAttribute('open', 'true');
      details.setAttribute('data-opened', 'true');
    } else {
      // Second click (menu already open) → go to URL
      window.location.href = url;
    }
  });
});

</script>


