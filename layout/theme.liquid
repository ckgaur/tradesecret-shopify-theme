<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}"{% if settings.enable_mode %} data-color-mode="{{ settings.color_mode }}"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

		<link rel="preconnect" href="https://cdn.shopify.com">
		<link rel="dns-prefetch" href="https://cdn.shopify.com">

		<link rel="preload" href="{{ 'base.css' | asset_url }}" as="style">

		<style>
			@media (min-width: 1200px) {
				.header.js-initializing {
					visibility: hidden;
				}
				.header__content {
					max-width: 85%;
					margin: 0 auto;
					display: flex;
					align-items: center;
					justify-content: space-between;
				}
				.header__inline-menu {
					max-width: 100% !important;
					width: 100% !important;
				}
			}
		</style>
		
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

		{% if settings.enable_mode %}
			<script>
				(function () {
					try {
						var savedScheme = localStorage.getItem('_color_mode');
						var defaultScheme = '{{ settings.color_mode }}';
						var scheme = savedScheme || defaultScheme;
						document.documentElement.setAttribute('data-color-mode', scheme);
						document.documentElement.classList.add('js');
					} catch (e) {}
				})();
			</script>
			<script src="{{ 'color-scheme-toggle.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    {%- if template.name == 'product' -%}
      {%- comment -%} Product page's media gallery/slider is above-the-fold and needs Swiper immediately. {%- endcomment -%}
      <link rel="preload" href="{{ 'swiper-bundle.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
      <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'swiper-slider.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      assign header_font_light = settings.type_header_font | font_modify: 'weight', '300'
      assign header_font_medium = settings.type_header_font | font_modify: 'weight', '500'
      assign header_font_semibold = settings.type_header_font | font_modify: 'weight', '600'
      assign header_font_bold = settings.type_header_font | font_modify: 'weight', 'bold'
      assign header_font_extrabold = settings.type_header_font | font_modify: 'weight', '800'
      assign header_font_black = settings.type_header_font | font_modify: 'weight', '900'
      assign header_font_italic = settings.type_header_font | font_modify: 'style', 'italic'
      assign header_font_light_italic = header_font_light | font_modify: 'style', 'italic'
      assign header_font_medium_italic = header_font_medium | font_modify: 'style', 'italic'
      assign header_font_semibold_italic = header_font_semibold | font_modify: 'style', 'italic'
      assign header_font_bold_italic = header_font_bold | font_modify: 'style', 'italic'
      assign header_font_extrabold_italic = header_font_extrabold | font_modify: 'style', 'italic'
      assign header_font_black_italic = header_font_black | font_modify: 'style', 'italic'

      assign body_font_light = settings.type_body_font | font_modify: 'weight', '300'
      assign body_font_regular = settings.type_body_font | font_modify: 'weight', '400'
      assign body_font_medium = settings.type_body_font | font_modify: 'weight', '500'
      assign body_font_semibold = settings.type_body_font | font_modify: 'weight', '600'
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_extrabold = settings.type_body_font | font_modify: 'weight', '800'
      assign body_font_black = settings.type_body_font | font_modify: 'weight', '900'
      assign body_font_light_italic = body_font_light | font_modify: 'style', 'italic'
      assign body_font_regular_italic = body_font_regular | font_modify: 'style', 'italic'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_medium_italic = body_font_medium | font_modify: 'style', 'italic'
      assign body_font_semibold_italic = body_font_semibold | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
      assign body_font_extrabold_italic = body_font_extrabold | font_modify: 'style', 'italic'
      assign body_font_black_italic = body_font_black | font_modify: 'style', 'italic'
    %}

    {% style %}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {{ header_font_light | font_face: font_display: 'swap' }}
      {{ header_font_medium | font_face: font_display: 'swap' }}
      {{ header_font_semibold | font_face: font_display: 'swap' }}
      {{ header_font_bold | font_face: font_display: 'swap' }}
      {{ header_font_extrabold | font_face: font_display: 'swap' }}
      {{ header_font_black | font_face: font_display: 'swap' }}
      {{ header_font_italic | font_face: font_display: 'swap' }}
      {{ header_font_light_italic | font_face: font_display: 'swap' }}
      {{ header_font_medium_italic | font_face: font_display: 'swap' }}
      {{ header_font_semibold_italic | font_face: font_display: 'swap' }}
      {{ header_font_bold_italic | font_face: font_display: 'swap' }}
      {{ header_font_extrabold_italic | font_face: font_display: 'swap' }}
      {{ header_font_black_italic | font_face: font_display: 'swap' }}

      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_light | font_face: font_display: 'swap' }}
      {{ body_font_regular | font_face: font_display: 'swap' }}
      {{ body_font_medium | font_face: font_display: 'swap' }}
      {{ body_font_semibold | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_extrabold | font_face: font_display: 'swap' }}
      {{ body_font_black | font_face: font_display: 'swap' }}
      {{ body_font_light_italic | font_face: font_display: 'swap' }}
      {{ body_font_regular_italic | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_medium_italic | font_face: font_display: 'swap' }}
      {{ body_font_semibold_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ body_font_extrabold_italic | font_face: font_display: 'swap' }}
      {{ body_font_black_italic | font_face: font_display: 'swap' }}

      {% for scheme in settings.color_schemes -%}
      	{% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
      	{% if forloop.index == 1 -%}
      		:root,
      	{%- endif %}
				{%- if settings.enable_mode and settings.light_color_scheme.id == scheme.id -%}
					[data-color-mode="light-mode"],
					[data-color-mode="light-mode"] .color-{{ settings.dark_color_scheme.id }},
				{%- endif -%}
				{%- if settings.enable_mode and settings.light_color_scheme_secondary.id == scheme.id -%}
					[data-color-mode="light-mode"] .color-{{ settings.dark_color_scheme_secondary.id }},
				{%- endif -%}
				{%- if settings.enable_mode and settings.dark_color_scheme.id == scheme.id -%}
					[data-color-mode="dark-mode"],
					[data-color-mode="dark-mode"] .color-{{ settings.light_color_scheme.id }},
				{%- endif %}
				{%- if settings.enable_mode and settings.dark_color_scheme_secondary.id == scheme.id -%}
					[data-color-mode="dark-mode"] .color-{{ settings.light_color_scheme_secondary.id }},
				{%- endif -%}
      	.color-{{ scheme.id }} {
      		--color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
      		{% if scheme.settings.background_gradient != empty %}
      			--gradient-background: {{ scheme.settings.background_gradient }};
      		{% else %}
      			--gradient-background: {{ scheme.settings.background }};
      		{% endif %}

					{% liquid
      			assign background_color = scheme.settings.background
      			assign background_color_brightness = background_color | color_brightness
      			if background_color_brightness <= 26
      				assign background_color_contrast = background_color | color_lighten: 50
      			elsif background_color_brightness <= 65
      				assign background_color_contrast = background_color | color_lighten: 5
      			else
      				assign background_color_contrast = background_color | color_darken: 25
      			endif
      		%}

      		--color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
      		--color-secondary-foreground: {{ scheme.settings.text_secondary.red }},{{ scheme.settings.text_secondary.green }},{{ scheme.settings.text_secondary.blue }};
      		--color-heading: {{ scheme.settings.text_heading.red }},{{ scheme.settings.text_heading.green }},{{ scheme.settings.text_heading.blue }};
      		--color-accent: {{ scheme.settings.accent.red }},{{ scheme.settings.accent.green }},{{ scheme.settings.accent.blue }};
      		--color-outline: {{ scheme.settings.outline.red }},{{ scheme.settings.outline.green }},{{ scheme.settings.outline.blue }};
      		--color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};
      		--color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};

      		--color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
      		--color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
      		--color-button-outline: {{ scheme.settings.button_outline.red }},{{ scheme.settings.button_outline.green }},{{ scheme.settings.button_outline.blue }};
      		--color-button-hover: {{ scheme.settings.button_hover.red }},{{ scheme.settings.button_hover.green }},{{ scheme.settings.button_hover.blue }};
      		--color-button-text-hover: {{ scheme.settings.button_label_hover.red }},{{ scheme.settings.button_label_hover.green }},{{ scheme.settings.button_label_hover.blue }};
      		--color-button-outline-hover: {{ scheme.settings.button_outline_hover.red }},{{ scheme.settings.button_outline_hover.green }},{{ scheme.settings.button_outline_hover.blue }};
      		--color-button-transparent: {{ scheme.settings.button_transparent.red }},{{ scheme.settings.button_transparent.green }},{{ scheme.settings.button_transparent.blue }};

      		--color-secondary-button: {{ scheme.settings.secondary_button.red }},{{ scheme.settings.secondary_button.green }},{{ scheme.settings.secondary_button.blue }};
      		--color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
      		--color-secondary-button-outline: {{ scheme.settings.secondary_button_outline.red }},{{ scheme.settings.secondary_button_outline.green }},{{ scheme.settings.secondary_button_outline.blue }};
      		--color-secondary-button-hover: {{ scheme.settings.secondary_button_hover.red }},{{ scheme.settings.secondary_button_hover.green }},{{ scheme.settings.secondary_button_hover.blue }};
      		--color-secondary-button-text-hover: {{ scheme.settings.secondary_button_label_hover.red }},{{ scheme.settings.secondary_button_label_hover.green }},{{ scheme.settings.secondary_button_label_hover.blue }};
      		--color-secondary-button-outline-hover: {{ scheme.settings.secondary_button_outline_hover.red }},{{ scheme.settings.secondary_button_outline_hover.green }},{{ scheme.settings.secondary_button_outline_hover.blue }};
      		--color-secondary-button-transparent: {{ scheme.settings.secondary_button_transparent.red }},{{ scheme.settings.secondary_button_transparent.green }},{{ scheme.settings.secondary_button_transparent.blue }};

					--socials-button: {{ scheme.settings.social_button.red }},{{ scheme.settings.social_button.green }},{{ scheme.settings.social_button.blue }};
      		--socials-button-text: {{ scheme.settings.social_button_label.red }},{{ scheme.settings.social_button_label.green }},{{ scheme.settings.social_button_label.blue }};
      		--socials-button-outline: {{ scheme.settings.social_button_outline.red }},{{ scheme.settings.social_button_outline.green }},{{ scheme.settings.social_button_outline.blue }};
      		--socials-button-hover: {{ scheme.settings.social_button_hover.red }},{{ scheme.settings.social_button_hover.green }},{{ scheme.settings.social_button_hover.blue }};
      		--socials-button-text-hover: {{ scheme.settings.social_button_label_hover.red }},{{ scheme.settings.social_button_label_hover.green }},{{ scheme.settings.social_button_label_hover.blue }};
      		--socials-button-outline-hover: {{ scheme.settings.social_button_outline_hover.red }},{{ scheme.settings.social_button_outline_hover.green }},{{ scheme.settings.social_button_outline_hover.blue }};

					--slider-button: {{ scheme.settings.slider_button.red }}, {{ scheme.settings.slider_button.green }}, {{ scheme.settings.slider_button.blue }};
					--slider-button-text: {{ scheme.settings.slider_button_label.red }},{{ scheme.settings.slider_button_label.green }},{{ scheme.settings.slider_button_label.blue }};
					--slider-button-outline: {{ scheme.settings.slider_button_outline.red }},{{ scheme.settings.slider_button_outline.green }},{{ scheme.settings.slider_button_outline.blue }};
					--slider-button-hover: {{ scheme.settings.slider_button_hover.red }},{{ scheme.settings.slider_button_hover.green }},{{ scheme.settings.slider_button_hover.blue }};
					--slider-button-text-hover: {{ scheme.settings.slider_button_label_hover.red }},{{ scheme.settings.slider_button_label_hover.green }},{{ scheme.settings.slider_button_label_hover.blue }};
					--slider-button-outline-hover: {{ scheme.settings.slider_button_outline_hover.red }},{{ scheme.settings.slider_button_outline_hover.green }},{{ scheme.settings.slider_button_outline_hover.blue }};

					--color-badge-foreground: var(--color-secondary-button-text);
					--color-badge-background: var(--color-secondary-button);
					--color-badge-border: var(--color-secondary-button-outline);
					--color-badge-foreground-hover: var(--color-secondary-button-text-hover);
					--color-badge-background-hover: var(--color-secondary-button-hover);
					--color-badge-border-hover: var(--color-secondary-button-outline-hover);
					--payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
					--input-border-color: {{ scheme.settings.input_border_color.red }}, {{ scheme.settings.input_border_color.green }}, {{ scheme.settings.input_border_color.blue }};
				}
			{% endfor %}

      {{ scheme_classes | prepend: 'body' }} {
				color: rgba(var(--color-foreground), 1);
				background-color: rgb(var(--color-background));
      }

			{% comment %} Mobile color schemes {% endcomment %}
			@media screen and (max-width: 749px) {
				{% for scheme in settings.color_schemes -%}
					.color-mobile-{{ scheme.id }} {
						--color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
						{% if scheme.settings.background_gradient != empty %}
							--gradient-background: {{ scheme.settings.background_gradient }};
						{% else %}
							--gradient-background: {{ scheme.settings.background }};
						{% endif %}

						--color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
						--color-secondary-foreground: {{ scheme.settings.text_secondary.red }},{{ scheme.settings.text_secondary.green }},{{ scheme.settings.text_secondary.blue }};
						--color-heading: {{ scheme.settings.text_heading.red }},{{ scheme.settings.text_heading.green }},{{ scheme.settings.text_heading.blue }};
						
						--color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
						--color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
						--color-button-outline: {{ scheme.settings.button_outline.red }},{{ scheme.settings.button_outline.green }},{{ scheme.settings.button_outline.blue }};
						--color-button-hover: {{ scheme.settings.button_hover.red }},{{ scheme.settings.button_hover.green }},{{ scheme.settings.button_hover.blue }};
						--color-button-text-hover: {{ scheme.settings.button_label_hover.red }},{{ scheme.settings.button_label_hover.green }},{{ scheme.settings.button_label_hover.blue }};
						--color-button-outline-hover: {{ scheme.settings.button_outline_hover.red }},{{ scheme.settings.button_outline_hover.green }},{{ scheme.settings.button_outline_hover.blue }};
						--color-button-transparent: {{ scheme.settings.button_transparent.red }},{{ scheme.settings.button_transparent.green }},{{ scheme.settings.button_transparent.blue }};

						--color-secondary-button: {{ scheme.settings.secondary_button.red }},{{ scheme.settings.secondary_button.green }},{{ scheme.settings.secondary_button.blue }};
						--color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
						--color-secondary-button-outline: {{ scheme.settings.secondary_button_outline.red }},{{ scheme.settings.secondary_button_outline.green }},{{ scheme.settings.secondary_button_outline.blue }};
						--color-secondary-button-hover: {{ scheme.settings.secondary_button_hover.red }},{{ scheme.settings.secondary_button_hover.green }},{{ scheme.settings.secondary_button_hover.blue }};
						--color-secondary-button-text-hover: {{ scheme.settings.secondary_button_label_hover.red }},{{ scheme.settings.secondary_button_label_hover.green }},{{ scheme.settings.secondary_button_label_hover.blue }};
						--color-secondary-button-outline-hover: {{ scheme.settings.secondary_button_outline_hover.red }},{{ scheme.settings.secondary_button_outline_hover.green }},{{ scheme.settings.secondary_button_outline_hover.blue }};
						--color-secondary-button-transparent: {{ scheme.settings.secondary_button_transparent.red }},{{ scheme.settings.secondary_button_transparent.green }},{{ scheme.settings.secondary_button_transparent.blue }};
					}
				{% endfor %}
			}

      :root {
				--compare-hover: {{ settings.compare_button_hover.red }},{{ settings.compare_button_hover.green }},{{ settings.compare_button_hover.blue }};
				--compare-text-hover: {{ settings.compare_button_label_hover.red }},{{ settings.compare_button_label_hover.green }},{{ settings.compare_button_label_hover.blue }};
				--compare-transparent: {{ settings.compare_button_transparent.red }},{{ settings.compare_button_transparent.green }},{{ settings.compare_button_transparent.blue }};

				--font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
				--font-body-style: {{ settings.type_body_font.style }};
				--font-body-weight: {{ settings.type_body_font.weight }};
				--font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};

				--font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
				--font-heading-style: {{ settings.type_header_font.style }};
				--font-heading-weight: {{ settings.type_header_font.weight }};

				--font-heading-0-size: {{ settings.heading_hero_size | divided_by: 10.00 }}rem;
				--font-heading-0-size-mb: {{ settings.heading_hero_size_mb | divided_by: 10.00 }}rem;
				--font-heading-0-xs-size: 8rem;
				--font-heading-0-xs-size-mb: 4.8rem;
				--font-heading-1-size: {{ settings.heading_1_size | divided_by: 10.00 }}rem;
				--font-heading-1-size-mb: {{ settings.heading_1_size_mb | divided_by: 10.00 }}rem;
				--font-heading-2-size: {{ settings.heading_2_size | divided_by: 10.00 }}rem;
				--font-heading-2-size-mb: {{ settings.heading_2_size_mb | divided_by: 10.00 }}rem;
				--font-heading-3-size: {{ settings.heading_3_size | divided_by: 10.00 }}rem;
				--font-heading-3-size-mb: {{ settings.heading_3_size_mb | divided_by: 10.00 }}rem;
				--font-heading-4-size: {{ settings.heading_4_size | divided_by: 10.00 }}rem;
				--font-heading-4-size-mb: {{ settings.heading_4_size_mb | divided_by: 10.00 }}rem;
				--font-heading-5-size: {{ settings.heading_5_size | divided_by: 10.00 }}rem;
				--font-heading-5-size-mb: {{ settings.heading_5_size_mb | divided_by: 10.00 }}rem;
				--font-heading-6-size: {{ settings.heading_6_size | divided_by: 10.00 }}rem;
				--font-heading-6-size-mb: {{ settings.heading_6_size_mb | divided_by: 10.00 }}rem;

				--f-size-text-lg: 2rem;
				--f-size-text-md: 1.6rem;
				--f-size-text-sm: 1.4rem;
				--f-size-text-x-sm: 1.2rem;

				--letter-spacing-hero: {{settings.heading_hero_letter_spacing | divided_by: 100.00 }}em;
				--letter-spacing-h1: {{settings.heading_1_letter_spacing | divided_by: 100.00 }}em;
				--letter-spacing-h2: {{settings.heading_2_letter_spacing | divided_by: 100.00 }}em;
				--letter-spacing-h3: {{settings.heading_3_letter_spacing | divided_by: 100.00 }}em;
				--letter-spacing-h4: {{settings.heading_4_letter_spacing | divided_by: 100.00 }}em;
				--letter-spacing-h5: {{settings.heading_5_letter_spacing | divided_by: 100.00 }}em;
				--letter-spacing-h6: {{settings.heading_6_letter_spacing | divided_by: 100.00 }}em;

				{%- if settings.enable_custom_heading_line_height -%}
					--line-height-hero: {{ settings.heading_hero_line_height | divided_by: 100.00 }};
					--line-height-h1: {{ settings.heading_1_line_height | divided_by: 100.00 }};
					--line-height-h2: {{ settings.heading_2_line_height | divided_by: 100.00 }};
					--line-height-h3: {{ settings.heading_3_line_height | divided_by: 100.00 }};
					--line-height-h4: {{ settings.heading_4_line_height | divided_by: 100.00 }};
					--line-height-h5: {{ settings.heading_5_line_height | divided_by: 100.00 }};
					--line-height-h6: {{ settings.heading_6_line_height | divided_by: 100.00 }};
				{%- endif -%}

				--media-padding: {{ settings.media_padding }}px;
				--media-border-opacity: {{ settings.media_border_opacity | divided_by: 100.0 }};
				--media-border-width: {{ settings.media_border_thickness }}px;
				--media-radius: {{ settings.media_radius }}px;

				--page-width: {{ settings.page_width | divided_by: 10 }}rem;
				--container-padding: 5rem;
				--container-padding-wide: 2rem;
				--page-width-margin: {% if settings.page_width == '1600' %}2{% else %}0{% endif %}rem;

				--product-card-image-padding: {{ settings.card_image_padding | divided_by: 10.0 }}rem;
