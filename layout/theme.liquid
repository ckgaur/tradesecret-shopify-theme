<script>
  document.addEventListener("DOMContentLoaded", function () {
  const sortContainer = document.querySelector('#SortBy');
  if (!sortContainer) return;

  // Listen for change on any radio input inside #SortBy
  sortContainer.addEventListener('change', function (event) {
    const target = event.target;
    if (target.name === 'sort_by' && target.checked) {
      const selectedValue = target.value;

      const url = new URL(window.location.href);
      url.searchParams.set('sort_by', selectedValue);

      // Optional: Add a loader class
      document.body.classList.add('loading');

      // Redirect to the URL with new sort_by param
      window.location.href = url.toString();
    }
  });

  // On page load: set checked radio based on URL param
  const urlParams = new URLSearchParams(window.location.search);
  const sortByParam = urlParams.get('sort_by');

  if (sortByParam) {
    const radioToCheck = sortContainer.querySelector(`input[name="sort_by"][value="${sortByParam}"]`);
    if (radioToCheck) {
      radioToCheck.checked = true;
    }
  }

  // Re-initialize infinite scroll if it's defined
  if (typeof resetInfiniteScroll === "function") {
    resetInfiniteScroll();
  }
});

</script>

