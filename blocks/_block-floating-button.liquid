<floating-button class="floating-button {% if block.settings.custom_alignment == true %} button-alignment--{{ block.settings.alignment }} button-alignment-mobile--{{ block.settings.alignment_mobile }}{% endif %}">

  <div class="floating-button__wrapper">
    <a {% if block.settings.button_link == blank %} role="link" aria-disabled="true" {% else %} href="{{ block.settings.button_link }}"{% endif %} class="button-block button{% if block.settings.button_icon != 'none' and block.settings.icon_position == 'left' %} button--icon-left{% elsif block.settings.button_icon != 'none' and block.settings.icon_position == 'right' %} button--icon-right{% endif %}{% if block.settings.button_label == blank %} button--has-no-label{% endif %}" {{ block.shopify_attributes }}>
      {% if block.settings.button_label != blank %}
        <span class="button__label">
          {{- block.settings.button_label | escape -}}
        </span>
      {% endif %}

      {% if block.settings.button_icon != 'none' %}
        <span class="button__icon">
          {% if block.settings.button_icon == 'icon-plus' %}
            <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="18" cy="18" r="18" fill="currentColor"/>
              <path d="M18.0001 10.8L18 25.2M25.2 18L10.8 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          {% elsif block.settings.button_icon == 'custom-icon' %}
            {% if block.settings.custom_icon != blank %}
              <img src="{{ block.settings.custom_icon | image_url: width: 36 }}" alt="{{ block.settings.button_label }}" width="36" height="{{ 36 | divided_by: block.settings.custom_icon.aspect_ratio | ceil }}" class="button__icon-image">
            {% endif %}
            {% if settings.enable_mode == true and block.settings.custom_icon != blank and block.settings.custom_icon_dark_mode != blank %}
              <img src="{{ block.settings.custom_icon_dark_mode | image_url: width: 36 }}" alt="{{ block.settings.button_label }}" width="36" height="{{ 36 | divided_by: block.settings.custom_icon_dark_mode.aspect_ratio | ceil }}" class="button__icon-image--dark-mode">
            {% endif %}
          {% endif %}
        </span>
      {% endif %}
    </a>
  </div>

  <script>
    (() => {
      const currentScript = document.currentScript;
      const floatingButton = currentScript && currentScript.closest('floating-button');
      if (!floatingButton) return;

      class FloatingButtonInView {
        constructor(root) {
          this.root = root;
          this.inViewClass = 'is-in-view';
          this.unstickClass = 'unstick-elements';
          this.observer = null;
          this.upperHalfObserver = null;
        }

        init() {
          if (!this.root) return;
          if (this.root.dataset.floatingButtonObserverInitialized === 'true') return;

          this.root.dataset.floatingButtonObserverInitialized = 'true';

          if (!('IntersectionObserver' in window)) {
            this.root.classList.add(this.inViewClass);
            return;
          }

          this.observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              this.root.classList.toggle(this.inViewClass, entry.isIntersecting);
            });
          });

          this.observer.observe(this.root);

          this.upperHalfObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              this.root.classList.toggle(this.unstickClass, entry.isIntersecting);
            });
          }, {
            rootMargin: '0px 0px -33% 0px'
          });

          this.upperHalfObserver.observe(this.root);
        }
      }

      const init = () => new FloatingButtonInView(floatingButton).init();

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true });
      } else {
        init();
      }
    })();
  </script>
</floating-button>

{% schema %}
{
  "name": "Floating button",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Only one button per section is allowed."
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Button label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "icon-plus",
          "label": "Icon plus"
        },
        {
          "value": "custom-icon",
          "label": "Custom icon"
        }
      ],
      "default": "icon-plus",
      "label": "Button icon"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "visible_if": "{{ block.settings.button_icon == 'custom-icon' }}"
    },
    {
      "type": "image_picker",
      "id": "custom_icon_dark_mode",
      "label": "Custom icon dark mode",
      "info": "If not selected, the custom icon will be used.",
      "visible_if": "{{ settings.enable_mode == true and block.settings.button_icon == 'custom-icon' and block.settings.custom_icon != blank }}"
    },
    {
      "type": "select",
      "id": "icon_position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right",
      "label": "Icon position",
      "visible_if": "{{ block.settings.button_icon != 'none' }}"
    },
    {
      "type": "checkbox",
      "id": "custom_alignment",
      "default": true,
      "label": "Custom button alignment"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Alignment",
      "visible_if": "{{ block.settings.custom_alignment == true }}"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Alignment mobile",
      "visible_if": "{{ block.settings.custom_alignment == true }}"
    }
  ],
  "presets": [
    {
      "name": "Floating button",
      "category": "Basic"
    }
  ]
}
{% endschema %}