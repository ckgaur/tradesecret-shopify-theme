{% liquid 
  assign cols_m = block.settings.cols_mobile
  assign cols_d = block.settings.cols_desktop
  assign cols_t_sm = block.settings.cols_mobile
  assign cols_t = block.settings.cols_desktop

  assign gap_h_m = block.settings.gap_h_m
  assign gap_h_d = block.settings.gap_h_d
  assign gap_h_t = gap_h_m | plus: gap_h_d | divided_by: 2 | round: 0

  assign gap_v_m = block.settings.gap_v_m
  assign gap_v_d = block.settings.gap_v_d
  assign gap_v_t = gap_v_m | plus: gap_v_d | divided_by: 2 | round: 0

  assign has_block_padding = false
  if block.settings.padding_block_start != 0 or block.settings.padding_block_end != 0 or block.settings.padding_inline_start != 0 or block.settings.padding_inline_end != 0
    assign has_block_padding = true
  endif

  if block.settings.padding_block_start_mobile != 0 or block.settings.padding_block_end_mobile != 0 or block.settings.padding_inline_start_mobile != 0 or block.settings.padding_inline_end_mobile != 0
    assign has_block_padding = true
  endif
%}

{% style %}
  #shopify-section-{{ section.id }}-row-{{ block.id }} {
    --gap-h-m: {{ gap_h_m }}px;
    --gap-h-t: {{ gap_h_t }}px;
    --gap-h-d: {{ gap_h_d }}px;
    --gap-v-m: {{ gap_v_m }}px;
    --gap-v-t: {{ gap_v_t }}px;
    --gap-v-d: {{ gap_v_d }}px;
  }
{% endstyle %}

<div id="shopify-section-{{ section.id }}-row-{{ block.id }}" class="block-row grid grid--{{ cols_m }}-mobile grid--{{ cols_t_sm }}-tablet-sm grid--{{ cols_t }}-tablet grid--{{ cols_d }}-desktop {% if block.settings.custom_columns_width == true and block.settings.cols_desktop == 2 and block.settings.columns_proportion != 50 %} columns-proportion{% endif %} block-row--vertical-{{ block.settings.vertical_alignment }} {% if has_block_padding %} block-padding{% endif %}" style="{% if has_block_padding %}{% render 'block-padding', settings: block.settings %}{% endif %}{% if block.settings.custom_columns_width == true and block.settings.cols_desktop == 2 and block.settings.columns_proportion != 50 %} --columns-proportion: {{ block.settings.columns_proportion }}%;{% endif %}{% if block.settings.row_width == 'percentage' %} --row-width: {{ block.settings.custom_row_width_percentage }}%{% endif %}{% if block.settings.row_width == 'pixels' %} --row-width: {{ block.settings.custom_row_width_pixels }}px{% endif %}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
  {
    "name": "Grid",
    "settings": [
      {
        "type": "select",
        "id": "row_width",
        "options": [
          {
            "value": "percentage",
            "label": "Percentage"
          },
          {
            "value": "pixels",
            "label": "Pixels"
          }
        ],
        "default": "percentage",
        "label": "Row width"
      },
      {
        "type": "range",
        "id": "custom_row_width_percentage",
        "min": 50,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 100,
        "label": "Custom row width",
        "visible_if": "{{ block.settings.row_width == 'percentage' }}"
      },
      {
        "type": "range",
        "id": "custom_row_width_pixels",
        "min": 400,
        "max": 1400,
        "step": 100,
        "unit": "px",
        "default": 1400,
        "label": "Custom row width",
        "visible_if": "{{ block.settings.row_width == 'pixels' }}"
      },
      {
        "type": "range",
        "id": "cols_desktop",
        "min": 1,
        "max": 6,
        "step": 1,
        "default": 3,
        "label": "t:blocks.grid.columns_desktop"
      },
      {
        "type": "checkbox",
        "id": "custom_columns_width",
        "label": "t:blocks.grid.custom_columns_width",
        "default": false,
        "visible_if": "{{ block.settings.cols_desktop == 2 }}"
      },
      {
        "type": "range",
        "id": "columns_proportion",
        "min": 30,
        "max": 70,
        "step": 1,
        "default": 50,
        "unit": "%",
        "label": "t:blocks.grid.columns_proportion",
        "visible_if": "{{ block.settings.cols_desktop == 2 and block.settings.custom_columns_width == true }}"
      },
      {
        "type": "range",
        "id": "cols_mobile",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 1,
        "label": "t:blocks.grid.columns_mobile"
      },
      {
        "type": "select",
        "id": "vertical_alignment",
        "options": [
          { 
            "value": "top", 
            "label": "Top" 
          },
          { 
            "value": "center", 
            "label": "Center" 
          },
          { 
            "value": "bottom", 
            "label": "Bottom" 
          }
        ],
        "default": "top",
        "label": "Vertical alignment",
        "visible_if": "{{ block.settings.cols_desktop > 1 or block.settings.cols_mobile > 1 }}"
      },
      {
        "type": "range",
        "id": "gap_h_d",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 8,
        "unit": "px",
        "label": "t:blocks.grid.grid_gap_h_desktop",
        "visible_if": "{{ block.settings.cols_desktop > 1 or block.settings.cols_mobile > 1 }}"
      },
      {
        "type": "range",
        "id": "gap_h_m",
        "min": 0,
        "max": 60,
        "step": 1,
        "default": 8,
        "unit": "px",
        "label": "t:blocks.grid.grid_gap_h_mobile",
        "visible_if": "{{ block.settings.cols_mobile > 1 }}"
      },
      {
        "type": "range",
        "id": "gap_v_d",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 16,
        "unit": "px",
        "label": "t:blocks.grid.grid_gap_v_desktop"
      },
      {
        "type": "range",
        "id": "gap_v_m",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 16,
        "unit": "px",
        "label": "t:blocks.grid.grid_gap_v_mobile"
      },
      {
        "type": "header",
        "content": "t:blocks.block_padding.padding"
      },
      {
        "type": "range",
        "id": "padding_block_start",
        "label": "t:blocks.block_padding.padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_end",
        "label": "t:blocks.block_padding.padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_start",
        "label": "t:blocks.block_padding.padding_left",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_end",
        "label": "t:blocks.block_padding.padding_right",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_start_mobile",
        "label": "t:blocks.block_padding.padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_end_mobile",
        "label": "t:blocks.block_padding.padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_start_mobile",
        "label": "t:blocks.block_padding.padding_left_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_end_mobile",
        "label": "t:blocks.block_padding.padding_right_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "block-grid-column"
      }
    ],
    "presets": [
      { 
        "name": "Grid",
        "category": "Layout"
      }
    ]
  }
{% endschema %}