{%- liquid
  assign has_block_padding = false
  if block.settings.padding_block_start != 0 or block.settings.padding_block_end != 0 or block.settings.padding_inline_start != 0 or block.settings.padding_inline_end != 0
    assign has_block_padding = true
  endif
  if block.settings.padding_block_start_mobile != 0 or block.settings.padding_block_end_mobile != 0 or block.settings.padding_inline_start_mobile != 0 or block.settings.padding_inline_end_mobile != 0
    assign has_block_padding = true
  endif
-%}

<rte-block class="block-text inline-richtext {{ block.settings.type_preset }}{% if block.settings.type_preset != 'rte' %} color--{{ block.settings.color }} font--{{ block.settings.font_family }}{% endif %}{% if has_block_padding %} block-padding{% endif %}{% if block.settings.custom_alignment == true %} text-{{ block.settings.alignment }} text-{{ block.settings.alignment_mobile }}-mobile{% endif %}{% if settings.animations_reveal_on_scroll and block.settings.type_preset == 'h0' or block.settings.type_preset == 'h1' or block.settings.type_preset == 'h2' or block.settings.type_preset == 'h3' or block.settings.type_preset == 'h4' %} scroll-trigger animate--text{% endif %}" style="--content-width: {{ block.settings.content_width }}px; --content-width-extra-large: {{ block.settings.content_width | times: 1.3333 }}px; {% if block.settings.type_preset == 'custom-font-size' %} --custom-font-size: {{ block.settings.custom_font_size }}px; --custom-font-size-mobile: {{ block.settings.custom_font_size_mobile }}px; {% endif %}{% if has_block_padding %}{% render 'block-padding', settings: block.settings %}{% endif %}" {{ block.shopify_attributes }}>
  {{ block.settings.text }}
</rte-block>

{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Use Heading 2(H2) for section heading, Heading 3(H3) for card heading."
    },
    {
      "type": "header",
      "content": "t:blocks.typography.header"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:blocks.typography.type_preset",
      "options": [
        {
          "value": "rte",
          "label": "Default"
        },
        {
          "value": "h0",
          "label": "Hero"
        },
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "subtitle",
          "label": "Subtitle"
        },
        {
          "value": "caption-with-letter-spacing",
          "label": "Uppercase"
        },
        {
          "value": "custom-font-size",
          "label": "Custom"
        }
      ],
      "default": "rte",
      "info": "t:blocks.typography.edit_presets_in_theme_settings"
    },
    {
      "type": "range",
      "id": "custom_font_size",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Custom font size",
      "visible_if": "{{ block.settings.type_preset == 'custom-font-size' }}"
    },
    {
      "type": "range",
      "id": "custom_font_size_mobile",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "Custom font size mobile",
      "visible_if": "{{ block.settings.type_preset == 'custom-font-size' }}"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "t:blocks.typography.font",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading-font",
          "label": "t:blocks.typography.font_options.heading"
        },
        {
          "value": "body-font",
          "label": "t:blocks.typography.font_options.body"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.type_preset != 'rte' }}"
    },
    {
      "type": "select",
      "id": "color",
      "label": "t:blocks.typography.color",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "heading-color",
          "label": "t:blocks.typography.color_options.heading"
        },
        {
          "value": "text-color",
          "label": "t:blocks.typography.color_options.text"
        },
        {
          "value": "text-secondary-color",
          "label": "t:blocks.typography.color_options.text_secondary"
        },
        {
          "value": "accent-color",
          "label": "t:blocks.typography.color_options.accent"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.type_preset != 'rte' }}"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 160,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1800,
      "label": "Content width"
    },
    {
      "type": "checkbox",
      "id": "custom_alignment",
      "default": false,
      "label": "Custom alignment"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Alignment",
      "visible_if": "{{ block.settings.custom_alignment == true }}"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Alignment mobile",
      "visible_if": "{{ block.settings.custom_alignment == true }}"
    },
    {
      "type": "header",
      "content": "t:blocks.block_padding.padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:blocks.block_padding.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:blocks.block_padding.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline_start",
      "label": "t:blocks.block_padding.padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline_end",
      "label": "t:blocks.block_padding.padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_start_mobile",
      "label": "t:blocks.block_padding.padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end_mobile",
      "label": "t:blocks.block_padding.padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline_start_mobile",
      "label": "t:blocks.block_padding.padding_left_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_inline_end_mobile",
      "label": "t:blocks.block_padding.padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    { 
      "name": "Section heading",
      "category": "Basic",
      "settings": {
        "text": "<h2>Section heading</h2>",
        "type_preset": "rte",
        "font_family": "default",
        "color": "default",
        "padding_block_start": 0,
        "padding_block_end": 0,
        "padding_inline_start": 0,
        "padding_inline_end": 0
      }
    },
    { 
      "name": "Card heading",
      "category": "Basic",
      "settings": {
        "text": "<h3>Card heading</h3>",
        "type_preset": "h6",
        "font_family": "default",
        "color": "default",
        "padding_block_start": 0,
        "padding_block_end": 0,
        "padding_inline_start": 0,
        "padding_inline_end": 0
      }
    },
    { 
      "name": "Text",
      "category": "Basic",
      "settings": {
        "text": "<p>Pair text with an image to give customers a better idea of what your product is.</p>",
        "type_preset": "rte",
        "font_family": "default",
        "color": "default",
        "padding_block_start": 0,
        "padding_block_end": 0,
        "padding_inline_start": 0,
        "padding_inline_end": 0
      }
    }
  ]
}
{% endschema %}