{% liquid
  if block.settings.image != blank
    assign media_aspect_ratio = block.settings.image.aspect_ratio
  else
    assign media_aspect_ratio = 1
  endif
  if block.settings.image_ratio == 'portrait'
    assign media_aspect_ratio = 0.8
  elsif block.settings.image_ratio == 'portrait_tall'
    assign media_aspect_ratio = 0.75
  elsif block.settings.image_ratio == 'portrait_extra_tall'
    assign media_aspect_ratio = 0.67
  elsif block.settings.image_ratio == 'square'
    assign media_aspect_ratio = 1
  elsif block.settings.image_ratio == 'landscape'
    assign media_aspect_ratio = 1.2
  elsif block.settings.image_ratio == 'landscape_wide'
    assign media_aspect_ratio = 1.33
  elsif block.settings.image_ratio == 'landscape_extra_wide'
    assign media_aspect_ratio = 1.5
  elsif block.settings.image_ratio == 'custom'
    assign custom_media_aspect_ratio = block.settings.custom_image_height | divided_by: 100.0
    assign media_aspect_ratio = 1 | divided_by: custom_media_aspect_ratio
  endif
  assign sizes = 'auto, (min-width: 750px) 100vw, 100vw'
  assign widths = '50, 60, 70, 80, 90, 100, 120, 140, 160, 180, 200, 240, 352, 375, 414, 440, 460, 480, 500, 750, 1000, 1250, 1500, 1750, 2000'

  assign img_alt = block.settings.image.alt | default: block.settings.image_dark_mode.alt | default: page.title | default: shop.name
  assign img_alt_dark = block.settings.image_dark_mode.alt | default: block.settings.image.alt | default: page.title | default: shop.name
%}

{%- liquid
  assign has_block_padding = false
  if block.settings.padding_block_start != 0 or block.settings.padding_block_end != 0 or block.settings.padding_inline_start != 0 or block.settings.padding_inline_end != 0
    assign has_block_padding = true
  endif
  if block.settings.padding_block_start_mobile != 0 or block.settings.padding_block_end_mobile != 0 or block.settings.padding_inline_start_mobile != 0 or block.settings.padding_inline_end_mobile != 0
    assign has_block_padding = true
  endif
-%}

{% capture image %}
  {%- if block.settings.image != blank -%}
    {{
      block.settings.image
      | image_url: width: block.settings.image.width
      | image_tag:
        width: block.settings.image.width,
        widths: widths,
        height: block.settings.image.height,
        alt: img_alt,
        class: 'image-block__image border-style image-block__image-light-mode',
        sizes: sizes
    }}
    {%- if block.settings.image_dark_mode != blank -%}
      {{
        block.settings.image_dark_mode
        | image_url: width: block.settings.image_dark_mode.width
        | image_tag:
          width: block.settings.image_dark_mode.width,
          widths: widths,
          height: block.settings.image_dark_mode.height,
          alt: img_alt_dark,
          class: 'image-block__image border-style image-block__image-dark-mode',
          sizes: sizes
      }}
    {%- endif -%}
  {%- else -%}
    <div class="placeholder-image">
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'hero__media' }}
    </div>
  {%- endif -%}
{% endcapture %}

<div class="image-block-wrapper{% if has_block_padding %} block-padding{% endif %}"{% if has_block_padding %} style="{% render 'block-padding', settings: block.settings %}"{% endif %} {{ block.shopify_attributes }}>
  {% if block.settings.link == blank %}
    <div class="image-block {% if block.settings.custom_alignment == true %}image-block--{{ block.settings.alignment }} image-block--{{ block.settings.alignment_mobile }}-mobile{% endif %}" style="--border-radius: {{ block.settings.image_border_radius }}px; --media-ratio: {{ media_aspect_ratio }}; --image-width: {% if block.settings.image_width == 'percentage' %}{{ block.settings.custom_image_width_percentage }}%{% else %}{{ block.settings.custom_image_width_pixels }}px{% endif %}">
      {{ image }}
    </div>
  {% else %}
    <a class="image-block{% if block.settings.custom_alignment == true %} image-block--{{ block.settings.alignment }} image-block--{{ block.settings.alignment_mobile }}-mobile{% endif %}" style="--border-radius: {{ block.settings.image_border_radius }}px; --media-ratio: {{ media_aspect_ratio }}; --image-width: {% if block.settings.image_width == 'percentage' %}{{ block.settings.custom_image_width_percentage }}%{% else %}{{ block.settings.custom_image_width_pixels }}px{% endif %}" href="{{ block.settings.link }}">
      {{ image }}
    </a>
  {% endif %}
</div>

{% schema %}
  {
    "name": "Image",
    "tag": null,
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "image_picker",
        "id": "image_dark_mode",
        "label": "Image dark mode",
        "info": "If not selected, the image will be used.",
        "visible_if": "{{ settings.enable_mode == true and block.settings.image != blank }}"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      },
      {
        "type": "select",
        "id": "image_ratio",
        "options": [
          {
            "value": "adapt",
            "label": "Adapt to image"
          },
          {
            "value": "portrait_extra_tall",
            "label": "Portrait extra tall"
          },
          {
            "value": "portrait_tall",
            "label": "Portrait tall"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "landscape",
            "label": "Landscape"
          },
          {
            "value": "landscape_wide",
            "label": "Landscape wide"
          },
          {
            "value": "landscape_extra_wide",
            "label": "Landscape extra wide"
          },
          {
            "value": "custom",
            "label": "Custom"
          }
        ],
        "default": "adapt",
        "label": "Image ratio"
      },
      {
        "type": "range",
        "id": "custom_image_height",
        "min": 40,
        "max": 140,
        "step": 1,
        "unit": "%",
        "default": 100,
        "label": "Custom image height",
        "visible_if": "{{ block.settings.image_ratio == 'custom' }}"
      },
      {
        "type": "select",
        "id": "image_width",
        "options": [
          {
            "value": "percentage",
            "label": "Percentage"
          },
          {
            "value": "pixels",
            "label": "Pixels"
          }
        ],
        "default": "percentage",
        "label": "Image width"
      },
      {
        "type": "range",
        "id": "custom_image_width_percentage",
        "min": 20,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 100,
        "label": "Custom image width",
        "visible_if": "{{ block.settings.image_width == 'percentage' }}"
      },
      {
        "type": "range",
        "id": "custom_image_width_pixels",
        "min": 20,
        "max": 500,
        "step": 5,
        "unit": "px",
        "default": 100,
        "label": "Custom image width",
        "visible_if": "{{ block.settings.image_width == 'pixels' }}"
      },
      {
        "type": "range",
        "id": "image_border_radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Image border radius",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "custom_alignment",
        "default": false,
        "label": "Custom alignment"
      },
      {
        "type": "select",
        "id": "alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left",
        "label": "Alignment",
        "visible_if": "{{ block.settings.custom_alignment == true }}"
      },
      {
        "type": "select",
        "id": "alignment_mobile",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left",
        "label": "Alignment mobile",
        "visible_if": "{{ block.settings.custom_alignment == true }}"
      },
      {
        "type": "header",
        "content": "t:blocks.block_padding.padding"
      },
      {
        "type": "range",
        "id": "padding_block_start",
        "label": "t:blocks.block_padding.padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_end",
        "label": "t:blocks.block_padding.padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_start",
        "label": "t:blocks.block_padding.padding_left",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_end",
        "label": "t:blocks.block_padding.padding_right",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_start_mobile",
        "label": "t:blocks.block_padding.padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_end_mobile",
        "label": "t:blocks.block_padding.padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_start_mobile",
        "label": "t:blocks.block_padding.padding_left_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_end_mobile",
        "label": "t:blocks.block_padding.padding_right_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ],
    "presets": [
      {
        "name": "Image",
        "category": "Basic"
      }
    ]
  }
{% endschema %}