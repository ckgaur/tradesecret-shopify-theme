{% liquid 
  assign cols_m = block.settings.cols_mobile
  assign cols_t = block.settings.cols_tablet
  assign cols_d = block.settings.cols_desktop

  assign gap_h_m = block.settings.gap_h_m
  assign gap_h_t = block.settings.gap_h_t
  assign gap_h_d = block.settings.gap_h_d

  assign has_block_padding = false
  if block.settings.padding_block_start != 0 or block.settings.padding_block_end != 0 or block.settings.padding_inline_start != 0 or block.settings.padding_inline_end != 0
    assign has_block_padding = true
  endif

  if block.settings.padding_block_start_mobile != 0 or block.settings.padding_block_end_mobile != 0 or block.settings.padding_inline_start_mobile != 0 or block.settings.padding_inline_end_mobile != 0
    assign has_block_padding = true
  endif
%}

{% style %}
  #shopify-section-{{ section.id }}-row-{{ block.id }} {
    --gap-h-m: {{ gap_h_m }}px;
    --gap-h-t: {{ gap_h_t }}px;
    --gap-h-d: {{ gap_h_d }}px;
  }
{% endstyle %}

{{ 'swiper.css' | asset_url | stylesheet_tag }}

<block-slideshow id="shopify-section-{{ section.id }}-row-{{ block.id }}" class="block-slideshow slideshow-width--{{ block.settings.slideshow_width }} block-slideshow--vertical-{{ block.settings.vertical_alignment }}{% if has_block_padding %} block-padding{% endif %}" style="{% if has_block_padding %}{% render 'block-padding', settings: block.settings %}{% endif %}{% if block.settings.autoplay == true %} --swiper-autoplay-delay: {{ block.settings.autoplay_delay | times: 1000 }}ms;{% endif %}" {{ block.shopify_attributes }}>

  {% if block.settings.slideshow_controls != 'none' and block.settings.slideshow_controls_position == 'top_left' or block.settings.slideshow_controls_position == 'top_center' or block.settings.slideshow_controls_position == 'top_right' %}
    <div class="slideshow-navigation slideshow-navigation--{{ block.settings.slideshow_controls_position }} slideshow-navigation--{{ block.settings.slideshow_controls_position_mobile }}-mobile">
      {% if block.settings.slideshow_controls == 'arrows' %}
        <div class="swiper-button swiper-button-prev button--animate-{{ settings.animations_hover_elements }}" tabindex="0">
          {% render 'icon-short-arrow' %}
        </div>
        <div class="swiper-button swiper-button-next button--animate-{{ settings.animations_hover_elements }}" tabindex="0">
          {% render 'icon-short-arrow' %}
        </div>
      {% elsif block.settings.slideshow_controls == 'pagination' %}
        <div class="swiper-pagination"></div>
      {% elsif block.settings.slideshow_controls == 'scrollbar' %}
        <div class="swiper-scrollbar"></div>
      {% endif %}
    </div>
  {% endif %}

  <div class="swiper" data-auto-slides-width="false" data-slides-per-view="{{ cols_d }}" data-slides-per-view-tablet="{{ cols_t }}" data-slides-per-view-mobile="{{ cols_m }}" data-space-between="{{ gap_h_d }}" data-space-between-tablet="{{ gap_h_t }}" data-space-between-mobile="{{ gap_h_m }}" data-autoplay="{{ block.settings.autoplay }}" data-autoplay-pause="{{ block.settings.autoplay_pause_on_hover }}" data-autoplay-delay="{{ block.settings.autoplay_delay | times: 1000 }}" data-scroll-speed="{{ block.settings.scroll_speed | times: 1000 }}">

    <div class="swiper-wrapper">

      {% content_for 'blocks' %}
      
    </div>

  </div>

  {% if block.settings.slideshow_controls != 'none' and block.settings.slideshow_controls_position == 'bottom_left' or block.settings.slideshow_controls_position == 'bottom_center' or block.settings.slideshow_controls_position == 'bottom_right' %}
    <div class="slideshow-navigation slideshow-navigation--{{ block.settings.slideshow_controls_position }} slideshow-navigation--{{ block.settings.slideshow_controls_position_mobile }}-mobile">
      {% if block.settings.slideshow_controls == 'arrows' %}
        <div class="swiper-button swiper-button-prev button--animate-{{ settings.animations_hover_elements }}" tabindex="0">
          {% render 'icon-short-arrow' %}
        </div>
        <div class="swiper-button swiper-button-next button--animate-{{ settings.animations_hover_elements }}" tabindex="0">
          {% render 'icon-short-arrow' %}
        </div>
      {% elsif block.settings.slideshow_controls == 'pagination' %}
        <div class="swiper-pagination"></div>
      {% elsif block.settings.slideshow_controls == 'scrollbar' %}
        <div class="swiper-scrollbar"></div>
      {% endif %}
    </div>
  {% endif %}

</block-slideshow>

<script data-lazy-src="{{ 'block-slideshow.js' | asset_url }}"></script>

{% schema %}
  {
    "name": "Slideshow",
    "settings": [
      {
        "type": "select",
        "id": "slideshow_width",
        "options": [
          {
            "value": "full-width",
            "label": "Full width"
          },
          {
            "value": "container-width",
            "label": "Container width"
          }
        ],
        "default": "full-width",
        "label": "Slideshow width"
      },
      {
        "type": "select",
        "id": "vertical_alignment",
        "options": [
          { 
            "value": "top", 
            "label": "Top" 
          },
          { 
            "value": "center", 
            "label": "Center" 
          },
          { 
            "value": "bottom", 
            "label": "Bottom" 
          }
        ],
        "default": "top",
        "label": "Vertical alignment"
      },
      {
        "type": "range",
        "id": "cols_desktop",
        "min": 1,
        "max": 6,
        "step": 0.1,
        "default": 3.3,
        "label": "Slides per view"
      },
      {
        "type": "range",
        "id": "cols_tablet",
        "min": 1,
        "max": 6,
        "step": 0.1,
        "default": 2.2,
        "label": "Slides per view tablet"
      },
      {
        "type": "range",
        "id": "cols_mobile",
        "min": 1,
        "max": 3,
        "step": 0.1,
        "default": 1.1,
        "label": "Slides per view mobile"
      },
      {
        "type": "range",
        "id": "gap_h_d",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 8,
        "unit": "px",
        "label": "Horizontal gap"
      },
      {
        "type": "range",
        "id": "gap_h_t",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 8,
        "unit": "px",
        "label": "Horizontal gap tablet"
      },
      {
        "type": "range",
        "id": "gap_h_m",
        "min": 0,
        "max": 60,
        "step": 1,
        "default": 8,
        "unit": "px",
        "label": "Horizontal gap mobile"
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Autoplay",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "autoplay_pause_on_hover",
        "label": "Autoplay pause on hover",
        "default": false,
        "visible_if": "{{ block.settings.autoplay == true}}"
      },
      {
        "type": "range",
        "id": "autoplay_delay",
        "label": "Autoplay delay",
        "min": 0,
        "max": 10,
        "step": 0.5,
        "default": 5,
        "unit": "s",
        "visible_if": "{{ block.settings.autoplay == true}}"
      },
      {
        "type": "range",
        "id": "scroll_speed",
        "label": "Scroll speed",
        "min": 0.5,
        "max": 30,
        "step": 0.5,
        "default": 1,
        "unit": "s"
      },
      {
        "type": "select",
        "id": "slideshow_controls",
        "options": [
          {
            "value": "none",
            "label": "None"
          },
          {
            "value": "arrows",
            "label": "Arrows"
          },
          {
            "value": "pagination",
            "label": "Pagination"
          },
          {
            "value": "scrollbar",
            "label": "Scrollbar"
          }
        ],
        "default": "none",
        "label": "Slideshow controls"
      },
      {
        "type": "select",
        "id": "slideshow_controls_position",
        "options": [
          {
            "value": "top_left",
            "label": "Top left"
          },
          {
            "value": "top_center",
            "label": "Top center"
          },
          {
            "value": "top_right",
            "label": "Top right"
          },
          {
            "value": "bottom_left",
            "label": "Bottom left"
          },
          {
            "value": "bottom_center",
            "label": "Bottom center"
          },
          {
            "value": "bottom_right",
            "label": "Bottom right"
          }
        ],
        "default": "bottom_center",
        "label": "Slideshow controls position",
        "visible_if": "{{ block.settings.slideshow_controls != 'none' }}"
      },
      {
        "type": "select",
        "id": "slideshow_controls_position_mobile",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "center",
        "label": "Slideshow controls position mobile",
        "visible_if": "{{ block.settings.slideshow_controls != 'none' }}"
      },
      {
        "type": "header",
        "content": "t:blocks.block_padding.padding"
      },
      {
        "type": "range",
        "id": "padding_block_start",
        "label": "t:blocks.block_padding.padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_end",
        "label": "t:blocks.block_padding.padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_start",
        "label": "t:blocks.block_padding.padding_left",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_end",
        "label": "t:blocks.block_padding.padding_right",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_start_mobile",
        "label": "t:blocks.block_padding.padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_end_mobile",
        "label": "t:blocks.block_padding.padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_start_mobile",
        "label": "t:blocks.block_padding.padding_left_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_end_mobile",
        "label": "t:blocks.block_padding.padding_right_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "block-slideshow-slide"
      }
    ],
    "presets": [
      { 
        "name": "Slideshow",
        "category": "Layout"
      }
    ]
  }
{% endschema %}