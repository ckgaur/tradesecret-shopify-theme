{%- liquid
  assign has_block_padding = false
  if block.settings.padding_block_start != 0 or block.settings.padding_block_end != 0 or block.settings.padding_inline_start != 0 or block.settings.padding_inline_end != 0
    assign has_block_padding = true
  endif
  if block.settings.padding_block_start_mobile != 0 or block.settings.padding_block_end_mobile != 0 or block.settings.padding_inline_start_mobile != 0 or block.settings.padding_inline_end_mobile != 0
    assign has_block_padding = true
  endif

  assign img_alt = block.settings.image.alt | default: block.settings.image_mb.alt | default: page.title | default: shop.name
  assign img_alt_mb = block.settings.image_mb.alt | default: block.settings.image.alt | default: page.title | default: shop.name
-%}

<div class="block-slideshow-slide card-style--card color-{{ block.settings.color_scheme }}{% if has_block_padding %} block-padding{% endif %}" style="{% if has_block_padding %}{% render 'block-padding', settings: block.settings %}{% endif %} --card-border-radius: {{ block.settings.card_border_radius }}px;" {{ block.shopify_attributes }}>
  <div class="block-slideshow-slide__media">
    {%- if block.settings.image -%}
      {%- liquid
        assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
        assign class = ''
        if block.settings.image_mb != blank
          assign class = 'small-hide'
        endif

        assign sizes = '100vw'
        assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
      -%}
      {{
        block.settings.image
        | image_url: width: 3840
        | image_tag: height: height,
        sizes: sizes,
        widths: widths,
        loading: 'lazy',
        alt: img_alt,
        class: class
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if block.settings.image_mb != blank  -%}
      {%- liquid
        assign mb_max_w = block.settings.image_mb.width | at_most: 1200
        assign height = mb_max_w | divided_by: block.settings.image_mb.aspect_ratio | round
        assign sizes = '100vw'
        assign widths = '375, 480, 640, 800, 960, 1200'
      -%}
      {{
        block.settings.image_mb
        | image_url: width: mb_max_w
        | image_tag: height: height,
        sizes: sizes,
        widths: widths,
        loading: 'lazy',
        alt: img_alt_mb,
        class: 'medium-hide large-up-hide'
      }}
    {%- endif -%}
  </div>

  <div class="block-slideshow-slide__height"> </div>
  
  <div class="block-slideshow-slide__content-wrapper banner__content--{{ block.settings.box_align }} banner__content-mobile--{{ block.settings.box_align_mobile }}">
    <div class="block-slideshow-slide__content block-slideshow-slide-alignment--{{ block.settings.text_alignment }} block-slideshow-slide-alignment-mobile--{{ block.settings.text_alignment_mobile }}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
  {
