          },
          {
            "value": "top-right",
            "label": "Top right"
          },
          {
            "value": "middle-left",
            "label": "Middle left"
          },
          {
            "value": "middle-center",
            "label": "Middle center"
          },
          {
            "value": "middle-right",
            "label": "Middle right"
          },
          {
            "value": "bottom-left",
