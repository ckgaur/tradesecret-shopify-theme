{%- liquid
  assign has_block_padding = false
  if block.settings.padding_block_start != 0 or block.settings.padding_block_end != 0 or block.settings.padding_inline_start != 0 or block.settings.padding_inline_end != 0
    assign has_block_padding = true
  endif
  if block.settings.padding_block_start_mobile != 0 or block.settings.padding_block_end_mobile != 0 or block.settings.padding_inline_start_mobile != 0 or block.settings.padding_inline_end_mobile != 0
    assign has_block_padding = true
  endif
-%}

<div class="block-slideshow-slide block-color-slideshow-slide card-style--card color-{{ block.settings.color_scheme }}{% if has_block_padding %} block-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="{% if has_block_padding %}{% render 'block-padding', settings: block.settings %}{% endif %} --card-border-radius: {{ block.settings.card_border_radius }}px;" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% style %}
  #shopify-block-{{ block.id }} {
    --slide-width-mobile: {{ block.settings.slide_width_mobile }}%;
    {% if block.settings.slide_width_mobile <= 50 and block.settings.slide_width_mobile > 33 %}
      --slide-width-mobile: calc({{ block.settings.slide_width_mobile }}% - var(--gap-h-d) / 2);
    {% endif %}
    {% if block.settings.slide_width_mobile <= 33 and block.settings.slide_width_mobile > 25 %}
      --slide-width-mobile: calc({{ block.settings.slide_width_mobile }}% - var(--gap-h-d) * 2 / 3);
    {% endif %}
    {% if block.settings.slide_width_mobile <= 25 and block.settings.slide_width_mobile > 20 %}
      --slide-width-mobile: calc({{ block.settings.slide_width_mobile }}% - var(--gap-h-d) * 3 / 4);
    {% endif %}

    --slide-width-tablet: {{ block.settings.slide_width_tablet }}%;
    {% if block.settings.slide_width_tablet <= 50 and block.settings.slide_width_tablet > 33 %}
      --slide-width-tablet: calc({{ block.settings.slide_width_tablet }}% - var(--gap-h-d) / 2);
    {% endif %}
    {% if block.settings.slide_width_tablet <= 33 and block.settings.slide_width_tablet > 25 %}
      --slide-width-tablet: calc({{ block.settings.slide_width_tablet }}% - var(--gap-h-d) * 2 / 3);
    {% endif %}
    {% if block.settings.slide_width_tablet <= 25 and block.settings.slide_width_tablet > 20 %}
      --slide-width-tablet: calc({{ block.settings.slide_width_tablet }}% - var(--gap-h-d) * 3 / 4);
    {% endif %}
    {% if block.settings.slide_width_tablet == 20 %}
      --slide-width-tablet: calc({{ block.settings.slide_width_tablet }}% - var(--gap-h-d) * 4 / 5);
    {% endif %}

    --slide-width-desktop: {{ block.settings.slide_width }}%;
    {% if block.settings.slide_width <= 50 and block.settings.slide_width > 33 %}
      --slide-width-desktop: calc({{ block.settings.slide_width }}% - var(--gap-h-d) / 2);
    {% endif %}
    {% if block.settings.slide_width <= 33 and block.settings.slide_width > 25 %}
      --slide-width-desktop: calc({{ block.settings.slide_width }}% - var(--gap-h-d) * 2 / 3);
    {% endif %}
    {% if block.settings.slide_width <= 25 and block.settings.slide_width > 20 %}
      --slide-width-desktop: calc({{ block.settings.slide_width }}% - var(--gap-h-d) * 3 / 4);
    {% endif %}
    {% if block.settings.slide_width == 20 %}
      --slide-width-desktop: calc({{ block.settings.slide_width }}% - var(--gap-h-d) * 4 / 5);
    {% endif %}
  }
  #shopify-block-{{ block.id }} .block-color-slideshow-slide {
    display: grid;
  }
{% endstyle %}

{% schema %}
  {
    "name": "Slide card",
    "class": "swiper-slide swiper-slide--color",
    "settings": [
      {
        "type": "paragraph",
        "content": "Read the [color slideshow setup guide](https://docs.muup.co/article/5247-color-slideshow?preview=6a3aa15a42108967823abbd1)."
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-2"
      },
      {
        "type": "range",
        "id": "card_border_radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 20,
        "label": "Card corner radius"
      },
      {
        "type": "range",
        "id": "slide_width",
        "min": 20,
        "max": 100,
        "step": 1,
        "default": 100,
        "unit": "%",
        "label": "Card width"
      },
      {
        "type": "range",
        "id": "slide_width_tablet",
        "min": 20,
        "max": 100,
        "step": 1,
        "default": 100,
        "unit": "%",
        "label": "Card width on tablet"
      },
      {
        "type": "range",
        "id": "slide_width_mobile",
        "min": 30,
        "max": 100,
        "step": 1,
        "default": 100,
        "unit": "%",
        "label": "Card width on mobile"
      },
      {
        "type": "header",
        "content": "t:blocks.block_padding.padding"
      },
      {
        "type": "range",
        "id": "padding_block_start",
        "label": "t:blocks.block_padding.padding_top",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_end",
        "label": "t:blocks.block_padding.padding_bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_start",
        "label": "t:blocks.block_padding.padding_left",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_end",
        "label": "t:blocks.block_padding.padding_right",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_start_mobile",
        "label": "t:blocks.block_padding.padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_block_end_mobile",
        "label": "t:blocks.block_padding.padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_start_mobile",
        "label": "t:blocks.block_padding.padding_left_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_inline_end_mobile",
        "label": "t:blocks.block_padding.padding_right_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "block-color-slideshow-image"
      }
    ],
    "presets": [
      { 
        "name": "Slide card",
        "category": "Layout",
        "blocks": {
          "image": {
            "type": "block-color-slideshow-image",
            "name": "Color variant image"
          }
        },
        "block_order": [
          "image"
        ]
      }
    ]
  }
{% endschema %}