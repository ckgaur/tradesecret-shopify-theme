{% liquid
  assign sizes = 'auto, (min-width: 750px) 100vw, 100vw'
  assign widths = '50, 60, 70, 80, 90, 100, 120, 140, 160, 180, 200, 240, 352, 375, 414, 440, 460, 480, 500, 750, 1000, 1250, 1500, 1750, 2000'

  assign img_alt = block.settings.image.alt | default: block.settings.variant_label | default: page.title | default: shop.name
%}

{% capture image %}
  {%- if block.settings.image != blank -%}
    {{
      block.settings.image
      | image_url: width: block.settings.image.width
      | image_tag:
        width: block.settings.image.width,
        widths: widths,
        height: block.settings.image.height,
        alt: img_alt,
        class: 'image-block__image border-style image-block__image-light-mode',
        sizes: sizes
    }}
  {%- else -%}
    <div class="placeholder-image">
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'hero__media' }}
    </div>
  {%- endif -%}
{% endcapture %}

<div class="image-block-wrapper block-color-slideshow-image-wrapper" data-variant-label="{{ block.settings.variant_label | escape }}" data-variant-color="{{ block.settings.variant_color }}">
  {% if block.settings.link == blank %}
    <div class="image-block block-color-slideshow-image" style="--border-radius: {{ block.settings.image_border_radius }}px;" {{ block.shopify_attributes }}>
      {{ image }}
    </div>
  {% else %}
    <a class="image-block block-color-slideshow-image" style="--border-radius: {{ block.settings.image_border_radius }}px;" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
      {{ image }}
    </a>
  {% endif %}
</div>

{% schema %}
  {
    "name": "Color variant image",
    "tag": null,
    "settings": [
      {
        "type": "paragraph",
        "content": "Read the [color slideshow setup guide](https://docs.muup.co/article/5247-color-slideshow?preview=6a3aa15a42108967823abbd1)."
      },
      {
        "type": "text",
        "id": "variant_label",
        "default": "Black",
        "label": "Color option name",
        "info": "Use the same name across cards to switch matching images together."
      },
      {
        "type": "color",
        "id": "variant_color",
        "default": "#121212",
        "label": "Color swatch",
        "info": "Shown as the sticky color navigation swatch."
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image for this color"
      },
      {
        "type": "range",
        "id": "image_border_radius",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 20,
        "label": "Image corner radius"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      }
    ],
    "presets": [
      {
        "name": "Color variant image",
        "category": "Basic"
      }
    ]
  }
{% endschema %}