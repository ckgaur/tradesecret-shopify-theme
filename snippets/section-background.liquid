{%- liquid
  assign bg_desktop = image_desktop
  assign bg_mobile = image_mobile | default: image_desktop

  if eager
    assign img_loading = 'eager'
    assign img_fetchpriority = 'high'
    assign img_decoding = 'sync'
  else
    assign img_loading = 'lazy'
    assign img_fetchpriority = 'auto'
    assign img_decoding = 'async'
  endif

  assign img_alt = bg_desktop.alt | default: bg_mobile.alt | default: page.title

  assign bg_class = 'background--' | append: bg_style
  if bg_mobile != blank
    assign bg_class = bg_class | append: ' background--' | append: bg_style_mobile
  endif
  if bg_desktop == blank
    assign bg_desktop = bg_mobile
    assign bg_class = bg_class | append: ' large-hide medium-hide'
  endif

  assign desktop_focal = bg_desktop.presentation.focal_point | default: '50% 50%'
  assign mobile_focal = bg_mobile.presentation.focal_point | default: desktop_focal
  assign bg_img_style = '--bg-focal-desktop: ' | append: desktop_focal | append: '; --bg-focal-mobile: ' | append: mobile_focal | append: '; object-position: var(--bg-focal-current, var(--bg-focal-desktop, center));'

  assign mobile_widths = '375,480,640,800,960,1200' | split: ','
  assign desktop_widths = '900,1200,1600,2000,2400' | split: ','

  assign fallback_max_w = bg_desktop.width | at_most: 2400
-%}

<div class="section-layout__background section-layout__background--{{ variant | default: 'light' }}">
  <picture aria-hidden="true">
    {%- if bg_mobile != bg_desktop -%}
      <source
        media="(max-width: 749px)"
        srcset="{%- for w in mobile_widths -%}{{ bg_mobile | image_url: width: w }} {{ w }}w{%- unless forloop.last -%}, {%- endunless -%}{%- endfor -%}"
        sizes="100vw"
      >
    {%- endif -%}

    {%- if image_desktop != blank -%}
      <source
        media="(min-width: 750px)"
        srcset="{%- for w in desktop_widths -%}{{ image_desktop | image_url: width: w }} {{ w }}w{%- unless forloop.last -%}, {%- endunless -%}{%- endfor -%}"
        sizes="100vw"
      >
    {%- endif -%}

    {{
      bg_desktop
      | image_url: width: fallback_max_w
      | image_tag:
        width: fallback_max_w,
        height: bg_desktop.height,
        sizes: '100vw',
        alt: img_alt,
        loading: img_loading,
        fetchpriority: img_fetchpriority,
        class: bg_class,
        style: bg_img_style,
        decoding: img_decoding
    }}
  </picture>
</div>