{%- comment -%}
  GSAP is only needed once an animated element is about to be scrolled to,
  and animations.js already gates its own work behind
  settings.animations_reveal_on_scroll, so its download is deferred until
  the customer interacts with the page (scroll, move, tap, key, click) or a
  5-second fallback timeout — same pattern as the third-party scripts.

  Note: swiper-bundle.js/css are intentionally NOT deferred here.
  slider-announcement-bar.js (used by the always-visible announcement bar)
  calls `new Swiper(...)` synchronously as soon as its custom element
  connects, with no readiness check — deferring the Swiper library made
  that throw "Swiper is not defined" on every page load and broke the
  announcement bar carousel. swiper-slider.js is safe to lazy-load on its
  own (it defers init via IntersectionObserver), but the library it
  depends on is not, so both stay on the regular eager <script> tags in
  theme.liquid.
{%- endcomment -%}
<script>
(function () {
  var loaded = false;
  var events = ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'];

  function loadScript(src, onload) {
    var s = document.createElement('script');
    s.src = src;
    s.defer = true;
    if (onload) s.onload = onload;
    document.head.appendChild(s);
  }

  function loadUILibraries() {
    if (loaded) return;
    loaded = true;

    loadScript('{{ "gsap.min.js" | asset_url }}', function () {
      {%- if settings.animations_reveal_on_scroll -%}
      loadScript('{{ "animations.js" | asset_url }}');
      {%- endif -%}
    });

    events.forEach(function (evt) {
      window.removeEventListener(evt, loadUILibraries, { passive: true });
    });
    clearTimeout(fallback);
  }

  events.forEach(function (evt) {
    window.addEventListener(evt, loadUILibraries, { passive: true, once: true });
  });

  var fallback = setTimeout(loadUILibraries, 5000);
})();
</script>
