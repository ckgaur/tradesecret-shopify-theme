<!-- Butterfly social feed (event-delayed load) -->
<script>
(function() {
  var loaded = false;
  function loadButterly() {
    if (loaded) return;
    loaded = true;
    var today = new Date();
    var stamp = today.getFullYear() + '-' + (today.getMonth() + 1) + '-' + today.getDate();
    var e = document.createElement('script');
    e.type = 'text/javascript';
    e.async = true;
    e.defer = true;
    e.src = 'https://butterly.com/richmedia/socialfeed/socialEmbed.js?stamp=' + stamp;
    var t = document.getElementsByTagName('script')[0];
    t.parentNode.insertBefore(e, t);

    events.forEach(function(evt) {
      window.removeEventListener(evt, loadButterly, { passive: true });
    });
    clearTimeout(fallback);
  }

  var events = ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'];
  events.forEach(function(evt) {
    window.addEventListener(evt, loadButterly, { passive: true, once: true });
  });

  var fallback = setTimeout(loadButterly, 5000);
})();
</script>
