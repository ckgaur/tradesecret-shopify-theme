<!-- Google Tag Manager (event-delayed load) -->
<script>
(function(w,d,s,l,i){
  w[l]=w[l]||[];
  w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});

  var loaded = false;
  function loadGTM() {
    if (loaded) return;
    loaded = true;
    var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),
        dl=l!='dataLayer'?'&l='+l:'';
    j.async=true;
    j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
    f.parentNode.insertBefore(j,f);

    events.forEach(function(evt) {
      w.removeEventListener(evt, loadGTM, { passive: true });
    });
    clearTimeout(fallback);
  }

  var events = ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'];
  events.forEach(function(evt) {
    w.addEventListener(evt, loadGTM, { passive: true, once: true });
  });

  var fallback = setTimeout(loadGTM, 5000);
})(window,document,'script','dataLayer','GTM-M27MMJCW');
</script>
<!-- End Google Tag Manager -->

