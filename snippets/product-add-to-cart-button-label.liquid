{% liquid
  assign current_variant = variant | default: product.selected_or_first_available_variant
  assign sold_out = false
  unless current_variant.available
    assign sold_out = true
  endunless
  if quantity_rule_soldout
    assign sold_out = true
  endif

  assign has_preorder_tag = false
  for tag in product.tags
    assign tag_h = tag | handleize
    if tag_h == 'pre-order' or tag_h == 'preorder'
      assign has_preorder_tag = true
      break
    endif
  endfor
%}
{%- if sold_out -%}
  {{- 'products.product.sold_out' | t -}}
{%- elsif has_preorder_tag -%}
  {{- 'products.product.pre_order' | t -}}
{%- else -%}
  {{- 'products.product.add_to_cart' | t -}}
{%- endif -%}
