<div class="card__badge {{ settings.badge_position }} {{ settings.badge_text_weight }}">
	{% for tag in product_obj.tags %}
		{%- liquid
			assign tag_handleize = tag | handleize
			assign badge_names = settings.badge_names | split: ','
		%}
		{% for badge in badge_names %}
			{% assign badge_handleize = badge | handleize %}
			{% if tag_handleize contains badge_handleize and  tag_handleize == badge_handleize %}
				<span class="badge{% if section.settings.badges_color == 'inverse' %} color-inverse{% else %} color-{{ settings.sale_badge_color_scheme }}{% endif %}" aria-hidden="true">
					{%- render 'product-badge-label', 
						badge: badge, 
						badge_handleize: badge_handleize 
					-%}
				</span>
			{% endif %}
		{% endfor %}
	{% endfor %}
	
	{%- if product_obj.compare_at_price > product_obj.price and product_obj.available -%}
		<span class="badge price__badge-sale{% if section.settings.badges_color == 'inverse' %} color-inverse{% else %} color-{{ settings.sale_badge_color_scheme }}{% endif %}">
			{% if settings.sale_badge_style == 'sale' %}
				{% if settings.sale_badge_text != blank %}
					{{- settings.sale_badge_text -}}
				{% else %}
					{{- 'products.product.on_sale' | t -}}
				{% endif %}
			{% elsif settings.sale_badge_style == 'saving' %}
				{%- assign savings = product_obj.compare_at_price | minus: product_obj.price | money_without_trailing_zeros -%}
				{% if settings.saving_badge_text != blank %}
					{{- settings.saving_badge_text }} {{ savings -}}
				{% else %}
					Save {{ savings -}}
				{% endif %}
			{% else %}
				{%- assign savings = product_obj.compare_at_price | minus: product_obj.price | times: 100.0 | divided_by: product_obj.compare_at_price | round | append: '%' -%}
				{% if settings.percentage_badge_text != blank %}
					{{- savings }} {{ settings.percentage_badge_text -}}
				{% else %}
					{{- savings }} Off 
				{% endif %}
			{% endif %}
		</span>
	{%- endif -%}

	{%- if product_obj.available == false -%}
		<span class="badge price__badge-sold-out{% if section.settings.badges_color == 'inverse' %} color-inverse{% else %} color-{{ settings.sold_out_badge_color_scheme }}{% endif %}" aria-hidden="true">
			{{ 'products.product.sold_out' | t }}
		</span>
	{%- endif -%}
</div>